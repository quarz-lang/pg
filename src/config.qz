# Where and how to connect: what a URL or `PG.connect`'s keywords say.
data Config = (
  # A host name or address, or a directory holding the server's unix
  # socket (a path starting with `/`).
  host: String,
  port: Int,
  user: String,
  password: String?,
  # nil: the user's name, as the server takes it.
  database: String?,
  application_name: String?,
  # Whether a password may be sent in clear over TCP (always over a unix
  # socket).
  allow_cleartext: Bool,
  # How long connecting and authenticating may take (nil: no limit).
  connect_timeout: Duration?,
  # The most SCRAM iterations the server may ask for (`PG::Scram`).
  max_scram_iterations: Int,
  # How many prepared statements `PG::Connection#query` keeps (0: none,
  # as a pooler in transaction mode needs).
  statement_cache_size: Int,
  # Whether and how TLS is used over TCP: `:disable`, `:allow`,
  # `:prefer`, `:require`, `:verify_ca` or `:verify_full` (`PG.connect`
  # says what each does). A unix socket never uses TLS.
  sslmode: Symbol,
  # The roots the server's certificate is verified against: a PEM file's
  # path, or `system` for the system's store (nil: `~/.postgresql/root.crt`
  # for `:verify_ca` and `:verify_full`, no verification for the others).
  sslrootcert: String?
)

# Reads a connection URL, as libpq does:
# `postgres://user:password@host:port/database?param=value`
# (`postgresql://` too). The parts are percent-decoded; `host` may be a
# socket directory (`%2Fvar%2Frun%2Fpostgresql`, or `?host=/var/run/...`);
# the parameters `host`, `port`, `user`, `password`, `dbname`,
# `application_name`, `connect_timeout` (seconds), `max_scram_iterations`,
# `statement_cache_size`, `sslmode` (`disable`, `allow`, `prefer`, the
# default, `require`, `verify-ca` or `verify-full`: see `PG.connect`) and
# `sslrootcert` are read. `channel_binding` may be `disable` or `prefer`
# (no channel binding either way) and `sslnegotiation` `postgres`.
# Client certificates (`sslcert`, `sslkey`, `sslpassword`), `sslcrl`
# and `channel_binding=require` are not supported: they raise
# `ArgumentError`, as does a malformed URL or an unknown parameter.
#
# ```
# c = PG.parse_url("postgres://ann:s%40cret@db.example:6543/shop?application_name=web")
# [c.host, c.port, c.user, c.password, c.database, c.application_name]
# # => ["db.example", 6543, "ann", "s@cret", "shop", "web"]
# PG.parse_url("postgres://ann@%2Ftmp/shop").host   # => "/tmp"
# PG.parse_url("postgres://h/d?sslmode=verify-full").sslmode   # => :verify_full
# PG.parse_url("postgres://h/d").sslmode                       # => :prefer
# PG.parse_url("postgres://h/d?sslcert=client.pem")  # raises ArgumentError
# ```
public def parse_url(url: String) -> Config
  m = url.match(/\Apostgres(?:ql)?:\/\/(?:([^@\/?#]*)@)?(\[[^\]\/]*\]|[^:\/?#]*)(?::([0-9]*))?(?:\/([^?#]*))?(?:\?([^#]*))?\z/)
  # The message leaves out what may be a password.
  raise ArgumentError.new("not a postgres:// URL: #{url.sub(/\/\/[^\/]*@/, "//***@").inspect}") unless m
  user: String? = nil
  password: String? = nil
  if (info = m[1])
    name, colon, secret = info.partition(":")
    user = Config.unescape(name)
    password = Config.unescape(secret) unless colon.empty?
  end
  host = m[2] || ""
  host = host[1, host.size - 2] if host.start_with?("[")
  host = Config.unescape(host)
  port = (m[3] || "").empty? ? 5432 : Config.port(m[3] || "")
  database = (m[4] || "").empty? ? nil : Config.unescape(m[4] || "")
  application_name: String? = nil
  connect_timeout: Duration? = nil
  max_scram_iterations = Scram::MAX_ITERATIONS
  statement_cache_size = Connection::STATEMENT_CACHE_SIZE
  sslmode = :prefer
  sslrootcert: String? = nil
  (m[5] || "").split("&").each do |pair|
    next if pair.empty?
    key, _, value = pair.partition("=")
    value = Config.unescape(value)
    case Config.unescape(key)
    when "host" then host = value
    when "port" then port = Config.port(value)
    when "user" then user = value
    when "password" then password = value
    when "dbname" then database = value
    when "application_name" then application_name = value
    when "connect_timeout"
      raise ArgumentError.new("connect_timeout: #{value.inspect}") unless value.match?(/\A[0-9]{1,9}\z/)
      connect_timeout = value.to_i == 0 ? nil : value.to_i.seconds
    when "max_scram_iterations"
      raise ArgumentError.new("max_scram_iterations: #{value.inspect}") unless value.match?(/\A[1-9][0-9]{0,9}\z/)
      max_scram_iterations = value.to_i
    when "statement_cache_size"
      raise ArgumentError.new("statement_cache_size: #{value.inspect}") unless value.match?(/\A[0-9]{1,6}\z/)
      statement_cache_size = value.to_i
    when "sslmode" then sslmode = Config.sslmode(value)
    when "sslrootcert"
      raise ArgumentError.new("sslrootcert: empty") if value.empty?
      sslrootcert = value
    when "channel_binding"
      unless value == "disable" || value == "prefer"
        raise ArgumentError.new("channel_binding=#{value}: this client has no channel binding (disable or prefer only)")
      end
    when "sslnegotiation"
      unless value == "postgres"
        raise ArgumentError.new("sslnegotiation=#{value}: this client negotiates TLS the postgres way only")
      end
    when "sslcert", "sslkey", "sslpassword"
      raise ArgumentError.new("#{key}: this client has no client certificates")
    when "sslcrl", "sslcrldir"
      raise ArgumentError.new("#{key}: this client does not check revocation lists")
    else
      raise ArgumentError.new("unknown connection parameter #{key.inspect}")
    end
  end
  Config.new(host: host.empty? ? "localhost" : host, port: port,
             user: user || Config.default_user, password: password, database: database,
             application_name: application_name, allow_cleartext: false,
             connect_timeout: connect_timeout, max_scram_iterations: max_scram_iterations,
             statement_cache_size: statement_cache_size, sslmode: sslmode, sslrootcert: sslrootcert)
end

extension Config
  # The user's name from the environment (PGUSER, then USER), as
  # libpq takes it when a URL names none.
  def self.default_user -> String = ENV["PGUSER"]? || ENV["USER"]? || "postgres"

  # `text` with its `%XX` escapes decoded. Raises `ArgumentError` on a
  # malformed escape or bytes that are not UTF-8.
  def self.unescape(text: String) -> String
    return text unless text.include?("%")
    b = Bytes::Builder.new
    bytes = text.to_bytes
    i = 0
    while i < bytes.size
      if bytes[i] == 37
        hex = i + 2 < bytes.size ? bytes.slice(i + 1, 2).decode : ""
        # Not quoting `text`, which may be a password.
        raise ArgumentError.new("a malformed %-escape in a connection URL") unless hex.match?(/\A[0-9A-Fa-f]{2}\z/)
        b << hex.to_i(16)
        i += 3
      else
        b << bytes[i]
        i += 1
      end
    end
    b.to_bytes.decode? || raise(ArgumentError.new("a %-escape that is not UTF-8 in a connection URL"))
  end

  # The `sslmode` a URL spells (`verify-full`), as a Symbol
  # (`:verify_full`). Raises `ArgumentError` for another value.
  def self.sslmode(text: String) -> Symbol
    mode = text.tr("-", "_").to_sym
    raise ArgumentError.new("sslmode: #{text.inspect}") unless sslmode?(mode) && !text.include?("_")
    mode
  end

  # Whether `mode` is a value of `sslmode`: `:disable`, `:allow`,
  # `:prefer`, `:require`, `:verify_ca` or `:verify_full`.
  def self.sslmode?(mode: Symbol) -> Bool
    [:disable, :allow, :prefer, :require, :verify_ca, :verify_full].include?(mode)
  end

  # A port number, 1 to 65535.
  def self.port(text: String) -> Int
    raise ArgumentError.new("port: #{text.inspect}") unless text.match?(/\A[0-9]{1,5}\z/) && (1..65535).include?(text.to_i)
    text.to_i
  end
end
