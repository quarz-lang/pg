# Where and how to connect: what a URL or [PG.connect]'s keywords say.
data Config(
  # A host name or address, or a directory holding the server's unix
  # socket (a path starting with `/`).
  host: String,
  port: Int,
  user: String,
  # A [Bytes::Secret] is used as it is: no [String] of it is made (its
  # limits: [PG::Frontend.password], [PG::Connection.md5_password]).
  password: (String | Bytes::Secret)?,
  # nil: the user's name, as the server takes it.
  database: String?,
  application_name: String?,
  # Whether a password may be sent in clear over TCP (always over a unix
  # socket).
  allow_cleartext: Bool,
  # How long connecting and authenticating may take (nil: no limit).
  connect_timeout: Duration?,
  # The most SCRAM iterations the server may ask for ([PG::Scram]).
  max_scram_iterations: Int,
  # How many prepared statements [PG::Connection#query] keeps (0: none,
  # as a pooler in transaction mode needs).
  statement_cache_size: Int,
  # Whether and how TLS is used over TCP: `:disable`, `:allow`,
  # `:prefer`, `:require`, `:verify_ca` or `:verify_full` ([PG.connect]
  # says what each does). A unix socket never uses TLS.
  sslmode: Symbol,
  # The roots the server's certificate is verified against: a PEM file's
  # path, or `system` for the system's store (nil: `~/.postgresql/root.crt`
  # when it exists; without roots, only `:verify_ca` and `:verify_full`
  # fail, the others go unverified).
  sslrootcert: String?,
  # Server settings for the session, sent at startup as libpq's
  # [options] (`-c search_path=app -c statement_timeout=5s`; nil:
  # none). A setting pg sends itself (DateStyle, client_encoding,
  # extra_float_digits, application_name) keeps pg's value: the server
  # takes the startup message's own parameters over these.
  options: String? = nil,
  # The authentication methods the server may ask for, as libpq's
  # `require_auth` ([Config.require_auth] reads its text): `:password`
  # (in clear), `:md5`, `:scram_sha_256`, `:none` (no authentication),
  # `:gss`, `:sspi`. nil: SCRAM-SHA-256 always, and md5 and no
  # authentication only when the server is authenticated otherwise (a
  # unix socket, or TLS verified against roots) (pg#49).
  require_auth: Array[Symbol]? = nil,
  # The fewest SCRAM iterations the server may ask for ([PG::Scram]).
  min_scram_iterations: Int = Scram::MIN_ITERATIONS
)
  # The configuration as text, the password left out (a configuration is
  # logged, interpolated and printed).
  def inspect -> String
    shown = password.nil? ? "nil" : "\"[FILTERED]\""
    "#<PG::Config host: #{host.inspect}, port: #{port}, user: #{user.inspect}, password: #{shown}, " \
      "database: #{database.inspect}, application_name: #{application_name.inspect}, " \
      "sslmode: #{sslmode.inspect}, sslrootcert: #{sslrootcert.inspect}, options: #{options.inspect}, " \
      "require_auth: #{require_auth.inspect}>"
  end

  def to_s -> String = inspect

  # The methods libpq's `require_auth` text allows: a comma-separated list
  # of `password`, `md5`, `scram-sha-256`, `none`, `gss` and `sspi`, or of
  # those each after `!`, which allows every method but them (pg#49).
  # Raises [ArgumentError] for an empty list, an unknown method, or
  # negated and plain methods mixed.
  #
  # ```
  # PG::Config.require_auth("scram-sha-256")   # => [:scram_sha_256]
  # PG::Config.require_auth("!md5,!none")      # => [:password, :scram_sha_256, :gss, :sspi]
  # ```
  def self.require_auth(text: String) -> Array[Symbol]
    methods = {"password" => :password, "md5" => :md5, "scram-sha-256" => :scram_sha_256,
               "none" => :none, "gss" => :gss, "sspi" => :sspi}
    names = text.split(",").map(&:strip)
    raise ArgumentError.new("require_auth: empty") if names.empty? || names.any?(&:empty?)
    negated = names.count { |n| n.start_with?("!") }
    unless negated == 0 || negated == names.size
      raise ArgumentError.new("require_auth: negated and plain methods mixed")
    end
    picked = names.map do |n|
      methods[n.delete_prefix("!")]? ||
        raise(ArgumentError.new("require_auth: not one of password, md5, scram-sha-256, none, gss, sspi (or each after !)"))
    end
    return picked.uniq if negated == 0
    methods.values.reject { |m| picked.include?(m) }
  end

  # :nodoc:
  # The configuration [PG.connect]'s keywords give: each nil keyword from
  # `env`, else its default (pg#71).
  def self.from_keywords(*, host: String? = nil, port: Int? = nil, user: String? = nil,
                         password: (String | Bytes::Secret)? = nil, database: String? = nil, application_name: String? = nil,
                         allow_cleartext: Bool = false, connect_timeout: Duration? = nil,
                         min_scram_iterations: Int = Scram::MIN_ITERATIONS,
                         max_scram_iterations: Int = Scram::MAX_ITERATIONS,
                         statement_cache_size: Int = Connection::STATEMENT_CACHE_SIZE,
                         sslmode: Symbol? = nil, sslrootcert: String? = nil, options: String? = nil,
                         require_auth: String? = nil, env: Hash[String, String] = ENV) -> Config
    if statement_cache_size < 0 || statement_cache_size > 999_999
      raise ArgumentError.new("statement_cache_size: #{statement_cache_size}")
    end
    if (mode = sslmode)
      raise ArgumentError.new("sslmode: #{mode.inspect}") unless Config.sslmode?(mode)
    end
    raise ArgumentError.new("sslrootcert: empty") if sslrootcert == ""
    config = Config.new(host: host || "localhost", port: port || 5432, user: user || "", password:, database:,
                        application_name:, allow_cleartext:, connect_timeout:, max_scram_iterations:,
                        statement_cache_size:, sslmode: Config.sslmode(sslmode, sslrootcert),
                        sslrootcert:, options:, require_auth: (t = require_auth) ? Config.require_auth(t) : nil,
                        min_scram_iterations:)
    given = [["host", host.nil?], ["port", port.nil?], ["user", user.nil?], ["password", password.nil?],
             ["database", database.nil?], ["application_name", application_name.nil?],
             ["connect_timeout", connect_timeout.nil?], ["sslmode", sslmode.nil?], ["sslrootcert", sslrootcert.nil?],
             ["options", options.nil?]].reject { |pair| pair[1] }.map { |pair| pair[0] }
    Config.with_env(config, given, env)
  end
end

# :nodoc:
# A connection URL's parts ([Config.url_parts]): the scheme; the user
# part's name as written and decoded, and its password, decoded (nil
# when the URL has none); the text from the host to the query, as
# written; the host, the port as written (empty: none), the database
# (empty: none), decoded; and the query's pairs, nil without a query.
data UrlParts = (scheme: String, user_text: String?, user: String?, password: String?, middle: String,
              host: String, port: String, database: String, pairs: Array[UrlPair]?)

# :nodoc:
# A `name=value` of a URL's query: as written, and its name and value
# decoded.
data UrlPair = (raw: String, name: String, value: String)

# Reads a connection URL, as libpq does:
# `postgres://user:password@host:port/database?param=value`
# (`postgresql://` too). The parts are percent-decoded; `host` may be a
# socket directory (`%2Fvar%2Frun%2Fpostgresql`, or `?host=/var/run/...`);
# the parameters `host`, `port`, `user`, `password`, `dbname`,
# `application_name`, `connect_timeout` (seconds), `min_scram_iterations`,
# `max_scram_iterations`, `statement_cache_size`, `sslmode` (`disable`, `allow`, `prefer`, the
# default, `require`, `verify-ca` or `verify-full`: see [PG.connect]) and
# `sslrootcert` (a PEM file's path, or `system`, which makes `sslmode`
# `verify-full` unless given, and refuses a weaker one) and `options`
# (server settings for the session, `-c name=value` each, as libpq
# sends them: [Config#options]) and `require_auth` (libpq's list of the
# authentication methods allowed: [Config.require_auth]) are read.
# `channel_binding` may be `disable` or `prefer` (no channel binding
# either way) and `sslnegotiation` `postgres`.
# Client certificates (`sslcert`, `sslkey`, `sslpassword`), `sslcrl`
# and `channel_binding=require` are not supported: they raise
# [ArgumentError], as does a malformed URL or an unknown parameter. The
# messages name what is wrong (the scheme, the user information, the
# host or port, a parameter) and never quote the URL or a value in it,
# which may hold a password.
#
# What the URL does not give comes from libpq's environment variables,
# as in libpq (pg#71): `PGHOST`, `PGPORT`, `PGUSER` (then `USER`, then
# `postgres`), `PGPASSWORD`, `PGDATABASE`, `PGAPPNAME`,
# `PGCONNECT_TIMEOUT`, `PGSSLMODE`, `PGSSLROOTCERT` and `PGOPTIONS`, read
# from `env` (the process's environment by default; `env: {}` reads
# none). A value the URL gives, empty included (`?options=`), is never
# taken from the environment; a variable set but empty is not set. A
# malformed variable raises [ArgumentError] naming it, never quoting its
# value; `PGHOST` and `PGPORT` with several hosts or ports (`a,b`) are
# refused. `PGPASSWORD` is the password of whatever user connects, and
# `PGSSLMODE` may weaken TLS below the default `prefer` (`disable`): a
# URL that must not depend on the environment spells these out.
# `PGPASSFILE` (`~/.pgpass`) and `PGSERVICE` are not read.
#
# ```
# c = PG.parse_url("postgres://ann:s%40cret@db.example:6543/shop?application_name=web")
# [c.host, c.port, c.user, c.password, c.database, c.application_name]
# # => ["db.example", 6543, "ann", "s@cret", "shop", "web"]
# PG.parse_url("postgres://ann@%2Ftmp/shop").host   # => "/tmp"
# PG.parse_url("postgres://h/d?sslmode=verify-full").sslmode   # => :verify_full
# PG.parse_url("postgres://h/d").sslmode                       # => :prefer
# PG.parse_url("postgres://h/d?sslrootcert=system").sslmode    # => :verify_full
# PG.parse_url("postgres://h/d?sslrootcert=system&sslmode=require")  # raises ArgumentError
# PG.parse_url("postgres://h/d?sslcert=client.pem")  # raises ArgumentError
# ```
public def parse_url(url: String, *, env: Hash[String, String] = ENV) -> Config
  config, given = read_url(url)
  Config.with_env(config, given, env)
end

# What [PG.parse_url] reads, with the same errors, without the
# environment: the configuration, its user empty when the URL names none,
# and the names of the values the URL gives ([Config.with_env]'s). (A
# value's text may be made at compile time, where the environment cannot
# be read: [PG::Testing::Server#inspect].)
def read_url(url: String) -> [Config, Array[String]]
  parts = Config.url_parts(url)
  user = parts.user
  password = parts.password
  host = parts.host
  port = parts.port.empty? ? 5432 : Config.port(parts.port)
  database = parts.database.empty? ? nil : parts.database
  application_name: String? = nil
  connect_timeout: Duration? = nil
  min_scram_iterations = Scram::MIN_ITERATIONS
  max_scram_iterations = Scram::MAX_ITERATIONS
  statement_cache_size = Connection::STATEMENT_CACHE_SIZE
  sslmode: Symbol? = nil
  sslrootcert: String? = nil
  options: String? = nil
  require_auth: Array[Symbol]? = nil
  given: Array[String] = []
  given = given.push("host") unless host.empty?
  given = given.push("port") unless parts.port.empty?
  given = given.push("user") unless user.nil?
  given = given.push("password") unless password.nil?
  given = given.push("database") unless parts.database.empty?
  (parts.pairs || Array[UrlPair].new).each do |pair|
    next if pair.raw.empty?
    name = pair.name
    value = pair.value
    mapped = name == "dbname" ? "database" : name
    given = given.push(mapped) if Config.env_variables.key?(mapped) && !given.include?(mapped)
    case name
    when "host" then host = value
    when "port" then port = Config.port(value)
    when "user" then user = value
    when "password" then password = value
    when "dbname" then database = value
    when "application_name" then application_name = value
    when "connect_timeout"
      raise ArgumentError.new("connect_timeout: not a number of seconds") unless value.match?(/\A[0-9]{1,9}\z/)
      connect_timeout = value.to_i == 0 ? nil : value.to_i.seconds
    when "min_scram_iterations"
      raise ArgumentError.new("min_scram_iterations: not a positive number") unless value.match?(/\A[1-9][0-9]{0,9}\z/)
      min_scram_iterations = value.to_i
    when "max_scram_iterations"
      raise ArgumentError.new("max_scram_iterations: not a positive number") unless value.match?(/\A[1-9][0-9]{0,9}\z/)
      max_scram_iterations = value.to_i
    when "statement_cache_size"
      raise ArgumentError.new("statement_cache_size: not a number from 0 to 999999") unless value.match?(/\A[0-9]{1,6}\z/)
      statement_cache_size = value.to_i
    when "sslmode" then sslmode = Config.sslmode(value)
    when "sslrootcert"
      raise ArgumentError.new("sslrootcert: empty") if value.empty?
      sslrootcert = value
    when "channel_binding"
      unless value == "disable" || value == "prefer"
        raise ArgumentError.new("channel_binding: this client has no channel binding (disable or prefer only)")
      end
    when "options" then options = value
    when "require_auth" then require_auth = Config.require_auth(value)
    when "sslnegotiation"
      unless value == "postgres"
        raise ArgumentError.new("sslnegotiation: this client negotiates TLS the postgres way only")
      end
    when "sslcert", "sslkey", "sslpassword"
      raise ArgumentError.new("#{name}: this client has no client certificates")
    when "sslcrl", "sslcrldir"
      raise ArgumentError.new("#{name}: this client does not check revocation lists")
    else
      # (Not quoted: a password written as a parameter is a key.)
      raise ArgumentError.new("an unknown parameter in the URL's query (its name is not quoted: it may be a password)")
    end
  end
  config = Config.new(host: host.empty? ? "localhost" : host, port: port,
                      user: user || "", password: password, database: database,
                      application_name: application_name, allow_cleartext: false,
                      connect_timeout: connect_timeout, max_scram_iterations: max_scram_iterations,
                      statement_cache_size: statement_cache_size,
                      sslmode: Config.sslmode(sslmode, sslrootcert), sslrootcert: sslrootcert,
                      options: options, require_auth: require_auth, min_scram_iterations: min_scram_iterations)
  [config, given]
end

extension Config
  # The user's name from the environment (PGUSER, then USER), as
  # libpq takes it when a URL names none.
  def self.default_user -> String = Config.default_user(ENV)

  # The user's name from `env` (PGUSER, then USER, each when set and not
  # empty), else `postgres`.
  def self.default_user(env: Hash[String, String]) -> String
    Config.env_value(env, "PGUSER") || Config.env_value(env, "USER") || "postgres"
  end

  # :nodoc:
  # The values libpq's environment variables give, by the name
  # [Config.with_env] knows them by (pg#71).
  def self.env_variables -> Hash[String, String]
    {"host" => "PGHOST", "port" => "PGPORT", "user" => "PGUSER", "password" => "PGPASSWORD",
                   "database" => "PGDATABASE", "application_name" => "PGAPPNAME",
                   "connect_timeout" => "PGCONNECT_TIMEOUT", "sslmode" => "PGSSLMODE",
                   "sslrootcert" => "PGSSLROOTCERT", "options" => "PGOPTIONS"}
  end

  # :nodoc:
  # The variable `name` of `env`: nil when unset or empty, as libpq.
  # Raises [ArgumentError] naming it (never its value: `PGPASSWORD`) when
  # it holds a NUL character, which no startup message can carry.
  def self.env_value(env: Hash[String, String], name: String) -> String?
    v = env[name]?
    return nil if v.nil? || v.empty?
    raise ArgumentError.new("#{name}: holds a NUL character") if v.include?("\x00")
    v
  end

  # :nodoc:
  # `config` with, for each value `given` does not name (a name of
  # [Config.env_variables]), the one its libpq variable in `env` gives (as
  # [PG.parse_url] says), each variable checked as the URL's parameter
  # of the same meaning; then the user from `USER` or `postgres`, and
  # the `sslmode` that follows from the mode given (by the URL or the
  # keywords, else `PGSSLMODE`) and the root certificates. The one place
  # the environment is read for a connection (pg#71).
  def self.with_env(config: Config, given: Array[String], env: Hash[String, String]) -> Config
    c = config
    ungiven = ->(name: String) { given.include?(name) ? nil : Config.env_value(env, Config.env_variables[name]) }
    if (h = ungiven.call("host"))
      raise ArgumentError.new("PGHOST: several hosts are not supported") if h.include?(",")
      c = c.with(host: h)
    end
    if (p = ungiven.call("port"))
      raise ArgumentError.new("PGPORT: several ports are not supported") if p.include?(",")
      c = c.with(port: Config.port(p, what: "PGPORT"))
    end
    c = c.with(user: Config.default_user(env)) unless given.include?("user")
    if (pw = ungiven.call("password"))
      c = c.with(password: pw)
    end
    if (d = ungiven.call("database"))
      c = c.with(database: d)
    end
    if (a = ungiven.call("application_name"))
      c = c.with(application_name: a)
    end
    if (t = ungiven.call("connect_timeout"))
      raise ArgumentError.new("PGCONNECT_TIMEOUT: not a number of seconds") unless t.match?(/\A[0-9]{1,9}\z/)
      c = c.with(connect_timeout: t.to_i == 0 ? nil : t.to_i.seconds)
    end
    if (r = ungiven.call("sslrootcert"))
      c = c.with(sslrootcert: r)
    end
    if (o = ungiven.call("options"))
      c = c.with(options: o)
    end
    mode: Symbol? = nil
    if given.include?("sslmode")
      mode = c.sslmode
    elsif (m = ungiven.call("sslmode"))
      mode = Config.sslmode(m, what: "PGSSLMODE")
    end
    c.with(sslmode: Config.sslmode(mode, c.sslrootcert))
  end

  # Why `url` is not a connection URL, without quoting any of it (its
  # user information may be a password that holds a `/`, `?`, `#` or
  # `@`): the first of the scheme, a `#`, an `@` and the host or port
  # that is wrong.
  def self.refusal(url: String) -> String
    unless url.match?(/\Apostgres(?:ql)?:\/\//)
      return "not a postgres:// URL: the scheme is not postgres:// or postgresql://"
    end
    if url.include?("#")
      return "not a postgres:// URL: a `#` must be written %23 (a URL fragment is not supported)"
    end
    # (User information that ends at an `@` before any `/`, `?` or `#`
    # is well formed, and the host or the port is what is wrong; else
    # an `@` further on may be the end of user information that holds
    # one of them.)
    if url.include?("@") && !url.match?(/\Apostgres(?:ql)?:\/\/[^@\/?#]*@/)
      return "not a postgres:// URL: the user information is malformed, or the host or the port (a `/`, `?`, `#` or `@` in a user name or password must be written %2F, %3F, %23 or %40)"
    end
    "not a postgres:// URL: the host or the port is malformed"
  end

  # :nodoc:
  # `url` cut into its parts as [PG.parse_url] reads them, decoded, with
  # what [PG::Testing::Server#inspect] shows: the user part as written
  # and the text between it and the query. Reads no environment (a
  # value's text may be made at compile time). Raises [ArgumentError] for
  # a URL the grammar refuses or a malformed escape, as [PG.parse_url]
  # does.
  def self.url_parts(url: String) -> UrlParts
    m = url.match(/\Apostgres(?:ql)?:\/\/(?:([^@\/?#]*)@)?(\[[^\]\/]*\]|[^:\/?#]*)(?::([0-9]*))?(?:\/([^?#]*))?(?:\?([^#]*))?\z/)
    raise ArgumentError.new(Config.refusal(url)) unless m
    scheme = url.partition("://")[0]
    rest = url[scheme.size + 3, url.size - scheme.size - 3]
    user: String? = nil
    password: String? = nil
    user_text: String? = nil
    if (info = m[1])
      name, colon, secret = info.partition(":")
      user = Config.unescape(name)
      password = Config.unescape(secret) unless colon.empty?
      user_text = name
      rest = rest[info.size + 1, rest.size - info.size - 1]
    end
    host = m[2] || ""
    host = host[1, host.size - 2] if host.start_with?("[")
    host = Config.unescape(host)
    database = Config.unescape(m[4] || "")
    pairs = (m[5] || "").split("&").map do |pair|
      key, _, value = pair.partition("=")
      v = Config.unescape(value)
      UrlPair.new(pair, Config.unescape(key), v)
    end
    UrlParts.new(scheme, user_text, user, password, rest.partition("?")[0], host, m[3] || "", database, m[5].nil? ? nil : pairs)
  end

  # `text` with its `%XX` escapes decoded. Raises [ArgumentError] on a
  # malformed escape or bytes that are not UTF-8.
  def self.unescape(text: String) -> String
    return text unless text.include?("%")
    b = Bytes::Builder.new
    bytes = text.to_bytes
    i = 0
    while i < bytes.size
      if bytes[i] == 37
        hex = i + 2 < bytes.size ? bytes.slice(i + 1, 2).decode : ""
        # Not quoting `text`, which may be a password.
        raise ArgumentError.new("a malformed %-escape in a connection URL") unless hex.match?(/\A[0-9A-Fa-f]{2}\z/)
        b << hex.to_i(16)
        i += 3
      else
        b << bytes[i]
        i += 1
      end
    end
    b.to_bytes.decode? || raise(ArgumentError.new("a %-escape that is not UTF-8 in a connection URL"))
  end

  # The `sslmode` a URL spells (`verify-full`), as a Symbol
  # (`:verify_full`). Raises [ArgumentError] for another value.
  def self.sslmode(text: String, *, what: String = "sslmode") -> Symbol
    mode = text.tr("-", "_").to_sym
    raise ArgumentError.new("#{what}: not one of disable, allow, prefer, require, verify-ca, verify-full") unless sslmode?(mode) && !text.include?("_")
    mode
  end

  # The `sslmode` of a connection given `mode` (nil: none given) and
  # `rootcert`: `:prefer` by default, `:verify_full` with the system's
  # roots, with which a weaker mode raises [ArgumentError] (libpq 16).
  def self.sslmode(mode: Symbol?, rootcert: String?) -> Symbol
    return mode || :prefer unless rootcert == "system"
    m = mode || :verify_full
    unless m == :verify_ca || m == :verify_full
      raise ArgumentError.new("sslmode #{m} with sslrootcert=system: the system's roots need verify-full")
    end
    m
  end

  # Whether `mode` is a value of `sslmode`: `:disable`, `:allow`,
  # `:prefer`, `:require`, `:verify_ca` or `:verify_full`.
  def self.sslmode?(mode: Symbol) -> Bool
    [:disable, :allow, :prefer, :require, :verify_ca, :verify_full].include?(mode)
  end

  # A port number, 1 to 65535 (`what` names it in the error).
  def self.port(text: String, *, what: String = "port") -> Int
    raise ArgumentError.new("#{what}: not a number from 1 to 65535") unless text.match?(/\A[0-9]{1,5}\z/) && (1..65535).include?(text.to_i)
    text.to_i
  end
end
