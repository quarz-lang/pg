# Connects to the server `url` names (`PG.parse_url` reads it), and
# authenticates. Raises `PG::ServerError` when the server refuses (a wrong
# password, a missing database), `PG::AuthenticationError` when this
# client cannot authenticate as the server asks, and `PG::ConnectionError`
# when the server cannot be reached or does not answer in time.
public def connect(url: String) -> Connection = Connection.open(parse_url(url))

# Connects as `PG.connect(url)` does, from keywords: `host` is a host name
# or address, or a directory holding the server's unix socket (a path
# starting with `/`). A password is sent in clear only over a unix socket,
# or when `allow_cleartext` says so. `max_scram_iterations` is the most
# SCRAM iterations the server may ask for, `statement_cache_size` how many
# prepared statements `PG::Connection#query` keeps.
public def connect(*, host: String = "localhost", port: Int = 5432, user: String = Config.default_user,
                   password: String? = nil, database: String? = nil, application_name: String? = nil,
                   allow_cleartext: Bool = false, connect_timeout: Duration? = nil,
                   max_scram_iterations: Int = Scram::MAX_ITERATIONS,
                   statement_cache_size: Int = Connection::STATEMENT_CACHE_SIZE) -> Connection
  if statement_cache_size < 0 || statement_cache_size > 999_999
    raise ArgumentError.new("statement_cache_size: #{statement_cache_size}")
  end
  Connection.open(Config.new(host:, port:, user:, password:, database:, application_name:,
                             allow_cleartext:, connect_timeout:, max_scram_iterations:,
                             statement_cache_size:))
end

# A session with the server: one task's at a time.
class Connection
  # How many prepared statements `#query` keeps by default.
  STATEMENT_CACHE_SIZE = 100

  @config: Config
  @statements: StatementCache
  @io: IO
  @reader: MessageReader
  var @parameters: Hash[String, String] = {}
  var @process_id: Int = 0
  var @secret: Bytes = Bytes.new
  var @status: String = "I"
  var @closed: Bool = false
  var @notice_handler: ((Hash[String, String]) -> Void)? = nil
  var @notice_error: StandardError? = nil

  # Connects with `config` and authenticates (see `PG.connect`).
  def self.open(config: Config) -> Connection
    if (limit = config.connect_timeout)
      begin
        Task.timeout(limit) { start(config) }
      rescue Task::Timeout
        raise ConnectionError.new("no answer from #{Connection.where(config)} within #{limit}")
      end
    else
      start(config)
    end
  end

  private def self.start(config: Config) -> Connection
    io = begin
      if config.host.start_with?("/")
        UNIXSocket.new("#{config.host}/.s.PGSQL.#{config.port}")
      else
        Socket.tcp(config.host, config.port)
      end
    rescue SystemCallError, SocketError, IOError => e
      raise ConnectionError.new("cannot connect to #{Connection.where(config)}: #{e.message}")
    end
    conn = Connection.new(config, io)
    begin
      conn.startup
    rescue Exception => e
      io.close
      raise e
    end
    conn
  end

  # Where `config` points, for messages.
  def self.where(config: Config) -> String
    config.host.start_with?("/") ? "#{config.host}/.s.PGSQL.#{config.port}" : "#{config.host}:#{config.port}"
  end

  # What `md5` authentication sends: `md5` and the hex digest of the hex
  # digest of `password` and `user`, then `salt`.
  def self.md5_password(user: String, password: String, salt: Bytes) -> String
    "md5" + Digest::MD5.hexdigest(Digest::MD5.hexdigest(password + user).to_bytes + salt)
  end

  # A connection over `io`, not started: `PG.connect` makes them.
  def initialize(@config: Config, @io: IO)
    @reader = MessageReader.new(io)
    @statements = StatementCache.new(@config.statement_cache_size)
  end

  # The run-time parameters the server reported (server_version,
  # TimeZone, client_encoding, standard_conforming_strings, ...),
  # kept up to date.
  def parameters -> Hash[String, String] = @parameters

  # The server's version, as `server_version` reports it (`"17.11 (Debian
  # 17.11-0+deb13u1)"`).
  def server_version -> String = @parameters["server_version"]? || ""

  # The server process serving this session.
  def process_id -> Int = @process_id

  # `:idle`, `:in_transaction` or `:failed` (a transaction an error
  # aborted), as of the last time the server was ready.
  def transaction_status -> Symbol
    case @status
    when "T" then :in_transaction
    when "E" then :failed
    else :idle
    end
  end

  # Calls the block with each notice or warning the server sends (its
  # fields, as `PG::ServerError#fields`); without a handler they are dropped.
  def on_notice(&handler: (Hash[String, String]) -> Void) -> Void
    @notice_handler = handler
  end

  # Runs `sql` (one statement or several, separated by `;`) with the
  # simple protocol, and returns the last statement's result. Raises
  # `PG::ServerError` for the first statement that fails, after which the
  # statements after it do not run (and, outside a transaction block, the
  # ones before it stay done). Takes no parameters: use `#query` for
  # values.
  #
  # A call that does not read the server's whole answer (its task was
  # cancelled or timed out, or a notice handler raised) closes the
  # connection: what is left of the answer would be taken for the next
  # one's.
  def exec(sql: String) -> Result = exec_all(sql).last? || Result.new([], [], "")

  # As `#exec`, but returns every statement's result, in order.
  def exec_all(sql: String) -> Array[Result]
    results: Array[Result] = []
    columns: Array[Field] = []
    rows: Array[Row] = []
    converse(Frontend.query(sql)) do |m|
      case m
      in Backend::RowDescription(fields:)
        columns = fields
        rows = []
      in Backend::DataRow(values:)
        rows = rows.push(Row.new(columns, values))
      in Backend::CommandComplete(tag:)
        # The server dropped every prepared statement.
        @statements.clear if tag == "DISCARD ALL" || tag == "DEALLOCATE ALL"
        results = results.push(Result.new(columns, rows, tag))
        columns = []
        rows = []
      in Backend::EmptyQueryResponse
        results = results.push(Result.new([], [], ""))
      else
        unexpected(m, "in a simple query")
      end
    end
    results
  end

  # Runs one statement with the extended protocol, `params` standing for
  # `$1`, `$2`, ...: each is sent apart from the SQL, so no value needs
  # quoting. A parameter may be nil (NULL), an Int, a Float, a String, a
  # Bool, Bytes (bytea), a Time (sent in UTC) or a Symbol (its name);
  # another raises `ArgumentError`. Raises `PG::ServerError` when the
  # statement fails. A call cut short closes the connection, as `#exec`
  # says.
  #
  # The statement is prepared once and kept, by its SQL text, among the
  # connection's `statement_cache_size` most recently used. One the server
  # no longer has (SQLSTATE 26000), or says changed under it (0A000, a
  # table altered) outside a transaction, is prepared again and the call
  # retried once; inside a transaction the 0A000 is raised (the
  # transaction is aborted), and the next call prepares it again.
  def query(sql: String, params: Array[Object?] = []) -> Result = run_query(sql, params, true)

  private def run_query(sql: String, params: Array[Object?], again: Bool) -> Result
    values = params.map { |p| Connection.encode(p) }
    columns: Array[Field] = []
    rows: Array[Row] = []
    tag = ""
    cached = @statements.enabled? ? @statements.lookup(sql) : nil
    name = cached || (@statements.enabled? ? @statements.next_name : "")
    # The messages that may raise (a NUL in the SQL, too many parameters)
    # are made before the cache gives up the statements it evicts.
    body = (cached ? Bytes.new : Frontend.parse(name, sql)) + Frontend.bind("", name, values) +
           Frontend.describe_portal("") + Frontend.execute("") + Frontend.sync
    @statements.make_room if @statements.enabled? && !cached
    b = Bytes::Builder.new
    @statements.take_closes.each { |n| b << Frontend.close_statement(n) }
    b << body
    parsed = false
    begin
      converse(b.to_bytes) do |m|
        case m
        in Backend::ParseComplete
          parsed = true
        in Backend::BindComplete | Backend::NoData | Backend::EmptyQueryResponse | Backend::CloseComplete
          nil
        in Backend::RowDescription(fields:)
          columns = fields
        in Backend::DataRow(values:)
          rows = rows.push(Row.new(columns, values))
        in Backend::CommandComplete(tag: t)
          tag = t
        else
          unexpected(m, "in an extended query")
        end
      end
    rescue ServerError => e
      if cached
        stale = case e.code
                when "26000"
                  @statements.drop(sql)
                  true
                when "0A000"
                  @statements.forget(sql)
                  @status == "I"
                else
                  false
                end
        return run_query(sql, params, false) if stale && again
      end
      raise e
    ensure
      # Prepared on the server, whatever came after (an execution error, a
      # notice handler's exception): the statement stays good.
      @statements.add(sql, name) if !cached && parsed && name != ""
    end
    # The server dropped every prepared statement.
    @statements.clear if tag == "DISCARD ALL" || tag == "DEALLOCATE ALL"
    Result.new(columns, rows, tag)
  end

  # How many prepared statements the connection keeps.
  def prepared_statements -> Int = @statements.size

  # Runs the block in a transaction: BEGIN, then COMMIT when the block
  # returns, or ROLLBACK when it raises (the exception goes on) or leaves
  # otherwise (`return`, `break`). When a statement in the block failed
  # and the block went on after rescuing it, the server rolls the
  # transaction back at COMMIT; this raises `PG::ServerError` (SQLSTATE 25P02)
  # then, rather than returning as if it had been committed. Returns the
  # block's value. Raises `PG::TransactionError` when the connection is in
  # a transaction already: there are no nested transactions (no
  # savepoints) yet.
  def transaction[R](&: (Connection) -> R) -> R
    unless @status == "I"
      raise TransactionError.new("already in a transaction: nested transactions are not supported yet")
    end
    exec("BEGIN")
    settled = false
    result = begin
      r = yield self
      settled = true
      r
    rescue Exception => e
      settled = true
      rollback_quietly
      raise e
    ensure
      # `return` or `break` out of the block.
      rollback_quietly unless settled
    end
    if exec("COMMIT").command_tag == "ROLLBACK"
      raise ServerError.new({ "S" => "ERROR", "V" => "ERROR", "C" => "25P02",
                        "M" => "the transaction was aborted by an earlier error and rolled back" })
    end
    result
  end

  # A parameter's text, as the server reads it (nil for NULL). A Time is
  # sent in UTC, so that a `timestamp` column (without zone), which drops
  # the offset, keeps the instant as `PG::Row#time` reads it back.
  #
  # ```
  # PG::Connection.encode(true)                # => b"t"
  # PG::Connection.encode(b"\x01\xff")       # => b"\\x01ff"
  # PG::Connection.encode(-Float::INFINITY)    # => b"-Infinity"
  # ```
  def self.encode(value: Object?) -> Bytes?
    text = case value
           in nil then return nil
           in Bool => b then b ? "t" : "f"
           in Int => i then i.to_s
           in Float => f
             if f.nan?
               "NaN"
             elsif f.infinite?
               f > 0 ? "Infinity" : "-Infinity"
             else
               f.to_s
             end
           in String => s then s
           in Symbol => s then s.to_s
           in Bytes => b then return "\\x#{b.hex}".to_bytes
           in Time => t then t.utc.iso8601(6)
           else raise ArgumentError.new("a parameter of class #{value.class.name}: " +
                                        "give nil, Int, Float, String, Bool, Bytes, Time or Symbol")
           end
    text.to_bytes
  end

  # Sends `request` and reads the answer up to ReadyForQuery, giving the
  # block every message but errors (the first is raised at the end, after
  # the connection is in step again) and ReadyForQuery. Anything that
  # leaves before the end (a cancelled task, an exception) closes the
  # connection.
  private def converse(request: Bytes, &handle: (Backend) -> Void) -> Void
    send(request)
    error: ServerError? = nil
    done = false
    begin
      loop do
        m = begin
          receive
        rescue ConnectionError => e
          # A FATAL error just before the server hung up says more.
          raise error || e
        end
        case m
        in Backend::ErrorResponse(fields:)
          error = error || ServerError.new(fields)
        in Backend::ReadyForQuery(status:)
          @status = status
          done = true
          break
        else
          handle.call(m)
        end
      end
    ensure
      unless done
        @closed = true
        close_io
      end
    end
    raise error if error
    if (e = @notice_error)
      @notice_error = nil
      raise e
    end
  end

  # Rolls back the transaction `#transaction` began, unless the
  # connection broke (the server then rolls it back itself). Errors are
  # dropped: the block's exception, if any, is the one to report.
  private def rollback_quietly -> Void
    return if @closed
    exec("ROLLBACK")
  rescue Exception
  end

  # Whether `#close` was called, or the connection broke.
  def closed? -> Bool = @closed

  # Ends the session: tells the server, and closes the socket. Closing a
  # closed connection does nothing.
  def close -> Void
    return if @closed
    @closed = true
    begin
      @io.write(Frontend.terminate)
    rescue IOError, SystemCallError
    end
    close_io
  end

  # The startup exchange: authentication, then the session's parameters,
  # up to the first ReadyForQuery. Called by `PG.connect`.
  def startup -> Void
    # The readers of `PG::Row` read ISO dates and floats in full.
    params = { "user" => @config.user, "client_encoding" => "UTF8", "DateStyle" => "ISO",
               "extra_float_digits" => "3" }
    if (db = @config.database)
      params = params.put("database", db)
    end
    if (app = @config.application_name)
      params = params.put("application_name", app)
    end
    send(Frontend.startup(params))
    authenticate
    loop do
      case m = receive
      in Backend::ReadyForQuery(status:)
        @status = status
        break
      in Backend::BackendKeyData(process_id:, secret:)
        @process_id = process_id
        @secret = secret
      in Backend::NegotiateProtocolVersion
        # Protocol 3.0 asked for and spoken; only options went unknown.
        nil
      in Backend::ErrorResponse(fields:)
        refused(fields)
      else
        unexpected(m, "while starting")
      end
    end
  end

  private def authenticate -> Void
    scram: Scram? = nil
    loop do
      case m = receive
      in Backend::AuthenticationOk
        if (s = scram) && !s.verified?
          raise AuthenticationError.new("the server ended SCRAM without proving that it knows the password")
        end
        break
      in Backend::AuthenticationCleartextPassword
        refuse_after_sasl(scram)
        unless @config.host.start_with?("/") || @config.allow_cleartext
          raise AuthenticationError.new("the server asks for the password in clear over TCP; " +
                                        "pass allow_cleartext: true to send it so")
        end
        send(Frontend.password(password))
      in Backend::AuthenticationMD5Password(salt:)
        refuse_after_sasl(scram)
        send(Frontend.password(Connection.md5_password(@config.user, password, salt)))
      in Backend::AuthenticationSASL(mechanisms:)
        unless mechanisms.include?(Scram::MECHANISM)
          raise AuthenticationError.new("the server offers SASL with #{mechanisms.join(", ")}, " +
                                        "and this client speaks #{Scram::MECHANISM} only")
        end
        refuse_after_sasl(scram)
        s = Scram.new(password, max_iterations: @config.max_scram_iterations)
        scram = s
        send(Frontend.sasl_initial_response(Scram::MECHANISM, s.client_first.to_bytes))
      in Backend::AuthenticationSASLContinue(data:)
        s = scram || unexpected(m, "before SASL started")
        send(Frontend.sasl_response(s.client_final(text(data)).to_bytes))
      in Backend::AuthenticationSASLFinal(data:)
        s = scram || unexpected(m, "before SASL started")
        s.verify(text(data))
      in Backend::AuthenticationOther(code:)
        raise AuthenticationError.new("the server asks for an authentication method this client " +
                                      "does not speak (code #{code}: Kerberos, GSSAPI or SSPI)")
      in Backend::ErrorResponse(fields:)
        refused(fields)
      else
        unexpected(m, "while authenticating")
      end
    end
  end

  # The server refused the session: it closes the connection.
  private def refused(fields: Hash[String, String]) -> Nothing
    @closed = true
    close_io
    raise ServerError.new(fields)
  end

  # A server that started SCRAM and then asks for a weaker method is not
  # followed.
  private def refuse_after_sasl(scram: Scram?) -> Void
    raise AuthenticationError.new("the server changed the authentication method during SCRAM") if scram
  end

  private def password -> String
    @config.password || raise(AuthenticationError.new("the server asks for a password, and none was given"))
  end

  private def text(data: Bytes) -> String
    data.decode? || raise(ProtocolError.new("SASL data that is not UTF-8"))
  end

  # Sends `bytes`; a failure breaks the connection.
  private def send(bytes: Bytes) -> Void
    raise ConnectionError.new("the connection is closed") if @closed
    @io.write(bytes)
  rescue IOError, SystemCallError => e
    broken(e.message)
  end

  # The next message that is not about the session itself: parameter
  # changes are recorded, and notices go to the handler.
  private def receive -> Backend
    loop do
      m = begin
        @reader.read
      rescue ConnectionError => e
        # The end of the stream, or bytes that are not the protocol.
        @closed = true
        close_io
        raise e
      rescue IOError, SystemCallError => e
        broken(e.message)
      end
      case m
      in Backend::ParameterStatus(name:, value:)
        @parameters = @parameters.put(name, value)
      in Backend::NoticeResponse(fields:)
        begin
          @notice_handler&.call(fields)
        rescue StandardError => e
          # Raised once the answer is read, to keep the stream in step.
          @notice_error = @notice_error || e
        end
      in Backend::NotificationResponse
        # LISTEN/NOTIFY has no API yet: dropped.
        nil
      else
        return m
      end
    end
  end

  private def broken(message: String) -> Nothing
    @closed = true
    close_io
    raise ConnectionError.new(message)
  end

  private def close_io -> Void
    @io.close
  rescue IOError, SystemCallError
  end

  private def unexpected(m: Backend, context: String) -> Nothing
    @closed = true
    close_io
    raise ProtocolError.new("unexpected #{m.class.name.split("::").last} #{context}")
  end
end
