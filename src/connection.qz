# Connects to the server `url` names ([PG.parse_url] reads it), and
# authenticates. Raises [PG::ServerError] when the server refuses (a wrong
# password, a missing database), [PG::AuthenticationError] when this
# client cannot authenticate as the server asks, and [PG::ConnectionError]
# when the server cannot be reached or does not answer in time.
# What the URL does not give comes from `env`, libpq's variables
# ([PG.parse_url]; `env: {}` reads none).
public def connect(url: String, *, env: Hash[String, String] = ENV) -> Connection = Connection.open(parse_url(url, env:))

# Connects as `PG.connect(url)` does, from keywords: `host` is a host name
# or address, or a directory holding the server's unix socket (a path
# starting with `/`). A password is sent in clear only over a unix socket,
# or when `allow_cleartext` says so. `min_scram_iterations` and
# A keyword not given (nil) takes its value from libpq's environment
# variables, as a URL's missing parts do ([PG.parse_url] lists them; `env`
# is the environment, `env: {}` reads none), else its default: `host`
# `"localhost"`, `port` 5432, `user` `USER`'s name or `postgres`, no
# password, the user's database, no connect timeout, `sslmode` `:prefer`
# (pg#71). `min_scram_iterations` and
# `max_scram_iterations` are the fewest and the most SCRAM iterations the
# server may ask for (4096 and 1,000,000 by default; [PG::Scram]),
# `statement_cache_size` how many
# prepared statements [PG::Connection#query] keeps. `options` holds server
# settings for the session, as libpq's `options` (`-c search_path=app`),
# which the server applies at startup ([PG::Config#options]).
#
# `sslmode` says whether the session goes over TLS ([PG::Connection#tls?]),
# as libpq's does:
#
# - `:disable`: never.
# - `:allow`: not at first; when the server refuses the session (a
#   `pg_hba.conf` that takes only `hostssl`), once more over TLS.
# - `:prefer` (the default, unless `sslrootcert` is `"system"`): over
#   TLS when the server speaks it, else in plain.
# - `:require`: over TLS, else [PG::ConnectionError].
# - `:verify_ca`, `:verify_full`: over TLS, the server's certificate
#   verified against the roots `sslrootcert` names, its name too (the
#   host as given, a name or an address). `:verify_ca` is `:verify_full`
#   here: the name is always verified, which is stricter than libpq.
#
# `sslrootcert` is a PEM file's path, or `"system"` for the system's
# store; nil means `~/.postgresql/root.crt`, read only when it exists
# (`:verify_ca` and `:verify_full` raise [PG::ConnectionError] when it
# does not). With `"system"`, `sslmode` is `:verify_full` unless given,
# and a weaker one (`:disable` to `:require`) raises [ArgumentError], as
# in libpq.
#
# With `:allow`, `:prefer` and `:require`, the server is verified (as
# with `:verify_full`) when there are roots: `sslrootcert`, or an
# existing `~/.postgresql/root.crt`, as libpq does; without them the
# session is encrypted but the server not authenticated. So a stale
# `root.crt` makes `:require` fail. A unix socket (`host` starting with `/`)
# never uses TLS, whatever `sslmode` says. A TLS failure (a certificate
# refused, a handshake that fails) is a [PG::ConnectionError] saying why.
#
# `require_auth` lists the authentication methods the server may ask for,
# as libpq's (`"scram-sha-256"`, `"md5,scram-sha-256"`, `"!password"`,
# [PG::Config.require_auth]); a method it does not list is a
# [PG::AuthenticationError] before anything is sent, and `none` allows a
# server that asks for no authentication. Without it, SCRAM-SHA-256 is
# allowed always, and md5 and no authentication only when the server is
# authenticated otherwise: over a unix socket, or over TLS verified
# against roots (`:verify_ca`, `:verify_full`, or roots with the other
# modes). Anyone answering as the server can otherwise ask for md5 (and
# get a value to guess the password from) or for none (and get the
# queries). A server still on md5 (`password_encryption = md5`) or
# `trust` over plain TCP needs `require_auth: "md5"` or `"none"` (pg#49).
# A password in clear also needs `allow_cleartext` over TCP.
public def connect(*, host: String? = nil, port: Int? = nil, user: String? = nil,
                   password: (String | Bytes::Secret)? = nil, database: String? = nil, application_name: String? = nil,
                   allow_cleartext: Bool = false, connect_timeout: Duration? = nil,
                   min_scram_iterations: Int = Scram::MIN_ITERATIONS,
                   max_scram_iterations: Int = Scram::MAX_ITERATIONS,
                   statement_cache_size: Int = Connection::STATEMENT_CACHE_SIZE,
                   sslmode: Symbol? = nil, sslrootcert: String? = nil, options: String? = nil,
                   require_auth: String? = nil, env: Hash[String, String] = ENV) -> Connection
  Connection.open(Config.from_keywords(host:, port:, user:, password:, database:, application_name:, allow_cleartext:, connect_timeout:,
                                       min_scram_iterations:, max_scram_iterations:, statement_cache_size:, sslmode:, sslrootcert:,
                                       options:, require_auth:, env:))
end


# Raises `ArgumentError` for a channel name the server cannot take as
# given: empty, holding a NUL, or of 64 bytes or more (an identifier
# that long is cut to 63 bytes, and `pg_notify` refuses it).
def check_channel(name: String) -> Void
  raise ArgumentError.new("an empty channel name") if name.empty?
  raise ArgumentError.new("a channel name holding a NUL") if name.include?("\x00")
  raise ArgumentError.new("a channel name of #{name.bytesize} bytes: 63 at most") if name.bytesize > 63
end

# A NOTIFY on a channel the connection listens to ([PG::Connection#listen]):
# the channel, the payload (`""` when none was given) and the server
# process that sent it ([PG::Connection#process_id] on the notifier's side).
data Notification = (channel: String, payload: String, process_id: Int)

# What a connection is made of, as a Shareable value: its socket and the
# session's state, so that it can move to another task, which makes a
# [PG::Connection] of it again ([PG::Connection#release],
# [PG::Connection.adopt]). [PG::Pool] keeps its idle connections so.
data Lease(
  io: IO,
  config: Config,
  process_id: Int,
  secret: Bytes,
  parameters: Hash[String, String],
  statements: StatementCache::Snapshot,
  # The notifications received and not yet taken, and the channels
  # listened to ([PG::Connection#listen]).
  notifications: Array[Notification],
  channels: Set[String],
  # Whether a LISTEN may be in force that [channels] does not show.
  unsure: Bool,
  # Where and how a CancelRequest for the session goes (pg#14).
  route: CancelRoute = CancelRoute.new(nil, nil)
)
  # The lease without its cancel key (`secret`) and its configuration's
  # password ([PG::Config#inspect]).
  def inspect -> String = "#<PG::Lease process_id: #{process_id}, config: #{config.inspect}>"

  # :ditto:
  def to_s -> String = inspect
end

# :nodoc:
# Where a CancelRequest for a session goes (pg#14): the server's address
# the session reached (nil: `config.host` again, or a UNIX socket's path),
# and the TLS configuration the session went over (nil: plain), which the
# cancel uses as it is.
data CancelRoute = (peer: Socket::Address?, tls: TLS::Config?)

# A session with the server: one task's at a time. Moving it to another
# task goes through a [PG::Lease].
class Connection
  # How many prepared statements [#query] keeps by default.
  STATEMENT_CACHE_SIZE = 100

  # The most a CancelRequest may take (connect, TLS, send, the server's
  # close), added to an interrupted call's time only when the server
  # does not answer.
  CANCEL_TIMEOUT = 5.seconds

  @config: Config
  @statements: StatementCache
  @io: IO
  @reader: MessageReader
  var @parameters: Hash[String, String] = {}
  var @process_id: Int = 0
  var @secret: Bytes = Bytes.new
  var @status: String = "I"
  var @closed: Bool = false
  var @notice_handler: ((Hash[String, String]) -> Void)? = nil
  var @notice_error: StandardError? = nil
  # Notifications received and not yet taken, oldest first.
  var @notifications: Array[Notification] = []
  # The channels `#listen` listened to, and whether a LISTEN may be in
  # force that they do not show (an UNLISTEN in a transaction, which a
  # rollback undoes).
  var @channels: Set[String] = Set[String].new
  var @unsure: Bool = false
  var @route: CancelRoute = CancelRoute.new(nil, nil)

  # The connection without its cancel key and its configuration's
  # password ([PG::Config#inspect]).
  def inspect -> String
    "#<PG::Connection process_id: #{@process_id}, closed: #{@closed}, config: #{@config.inspect}>"
  end

  # Connects with `config` and authenticates (see [PG.connect]).
  def self.open(config: Config) -> Connection
    if (limit = config.connect_timeout)
      begin
        Task.timeout(limit) { start(config) }
      rescue Task::Timeout
        raise ConnectionError.new("no answer from #{Connection.where(config)} within #{limit}")
      end
    else
      start(config)
    end
  end

  private def self.start(config: Config) -> Connection
    # (libpq does the same: a unix socket is never encrypted.)
    return start(config, false) if config.host.start_with?("/")
    case config.sslmode
    when :disable then start(config, false)
    when :allow
      begin
        start(config, false)
      rescue ServerError
        # A `pg_hba.conf` that takes only `hostssl`: once more, over TLS.
        start(config, true)
      end
    else start(config, true)
    end
  end

  # Connects and starts the session: over TLS when `tls` says so and the
  # server agrees (it must, unless `sslmode` is `:prefer` or `:allow`).
  private def self.start(config: Config, tls: Bool) -> Connection
    # Roots asked for (`sslrootcert`, or the verify modes, which need
    # them) are read before connecting: a missing file is the caller's
    # mistake. For `:allow`, `:prefer` and `:require` without
    # `sslrootcert`, `~/.postgresql/root.crt` is read only when the
    # server agrees to TLS.
    asked = tls && (config.sslrootcert || config.sslmode == :verify_ca || config.sslmode == :verify_full)
    early = asked ? tls_config(config) : nil
    io: IO = begin
      if config.host.start_with?("/")
        UNIXSocket.new("#{config.host}/.s.PGSQL.#{config.port}")
      else
        Socket.tcp(config.host, config.port)
      end
    rescue SystemCallError, SocketError, IOError => e
      raise ConnectionError.new("cannot connect to #{Connection.where(config)}: #{e.message}")
    end
    begin
      peer: Socket::Address? = nil
      used: TLS::Config? = nil
      if (sock = io.as?(TCPSocket))
        peer = begin
                 sock.remote_address
               rescue IOError
                 nil
               end
        if tls
          io, used = secure(config, sock, early)
        end
      end
      conn = Connection.new(config, io)
      conn.cancel_route = CancelRoute.new(peer, used)
      conn.startup
      conn
    rescue Exception => e
      begin
        io.close
      rescue IOError, SystemCallError
      end
      raise e
    end
  end

  # Asks the server for TLS (an SSLRequest) and runs the handshake when it
  # agrees; when it refuses, `sock` itself unless TLS is required. With
  # the TLS configuration used (nil: plain).
  private def self.secure(config: Config, sock: TCPSocket, tls: TLS::Config?) -> [IO, TLS::Config?]
    answer = begin
      sock.write(Frontend.ssl_request)
      sock.read_bytes(1)
    rescue IOError, SystemCallError => e
      raise ConnectionError.new("cannot connect to #{Connection.where(config)}: #{e.message}")
    end
    case answer
    when b"S"
      t = tls || tls_config(config)
      begin
        [TLSSocket.connect(sock, config.host, t), t]
      rescue IOError, SystemCallError, ArgumentError => e
        # (`TLS::Error` is an `IOError`; `ArgumentError`: a host that is
        # not a server name to TLS, an IPv6 address with a zone, say.)
        raise ConnectionError.new("cannot connect to #{Connection.where(config)}: #{e.message}")
      end
    when b"N"
      if config.sslmode == :prefer || config.sslmode == :allow
        [sock, nil]
      else
        raise ConnectionError.new("#{Connection.where(config)}: the server does not support SSL (sslmode #{config.sslmode})")
      end
    when b""
      raise ConnectionError.new("#{Connection.where(config)}: the server closed the connection at the SSL request")
    else
      # (An `E`: a server older than 7.0, or not PostgreSQL.)
      raise ProtocolError.new("#{Connection.where(config)}: the server answered the SSL request with #{answer.inspect}")
    end
  end

  # The TLS configuration `config` asks for: verified when there are
  # roots (`sslrootcert`, or an existing `~/.postgresql/root.crt`, as
  # libpq does), which `:verify_ca` and `:verify_full` require.
  private def self.tls_config(config: Config) -> TLS::Config
    path = config.sslrootcert
    unless path
      home = ENV["HOME"]? || ""
      default = "#{home}/.postgresql/root.crt"
      if !home.empty? && File.exist?(default)
        return TLS::Config.new(roots: roots(default, true))
      elsif config.sslmode == :verify_ca || config.sslmode == :verify_full
        raise ConnectionError.new("sslmode #{config.sslmode} needs the roots to verify the server against: " +
                                  "give sslrootcert (a PEM file, or system), or put them in #{default}")
      else
        return TLS::Config.new(verify: false)
      end
    end
    return TLS::Config.new(roots: TLS::Roots.system) if path == "system"
    TLS::Config.new(roots: roots(path, false))
  end

  # The roots of the PEM file `path`: an `ArgumentError` when it cannot
  # be read or holds none, a `PG::ConnectionError` for `~/.postgresql/root.crt`
  # (`default`), which the caller did not name.
  private def self.roots(path: String, default: Bool) -> TLS::Roots
    problem = begin
      pem = File.read_bytes(path)
      return TLS::Roots.from_pem(pem) unless pem.empty?
      "empty"
    rescue IOError, SystemCallError => e
      # (`TLS::Error`, a file that holds no certificate, is an `IOError`.)
      e.message
    end
    raise ConnectionError.new("the roots in #{path}: #{problem}") if default
    raise ArgumentError.new("sslrootcert #{path}: #{problem}")
  end

  # Where `config` points, for messages.
  def self.where(config: Config) -> String
    config.host.start_with?("/") ? "#{config.host}/.s.PGSQL.#{config.port}" : "#{config.host}:#{config.port}"
  end

  # What `md5` authentication sends: `md5` and the hex digest of the hex
  # digest of `password` and `user`, then `salt`. A [Bytes::Secret]
  # password makes no [String], but MD5 takes no secret: its bytes and
  # the user's are joined in a plain [Bytes] for the digest, which
  # nothing clears.
  def self.md5_password(user: String, password: String | Bytes::Secret, salt: Bytes) -> String
    inner = case password
            in String then Digest::MD5.hexdigest(password + user)
            in Bytes::Secret then Digest::MD5.hexdigest((Bytes::Builder.new << password.expose_bytes << user).to_bytes)
            end
    "md5" + Digest::MD5.hexdigest(inner.to_bytes + salt)
  end

  # A connection over `io`, not started: [PG.connect] makes them.
  def initialize(@config: Config, @io: IO)
    @reader = MessageReader.new(io)
    @statements = StatementCache.new(@config.statement_cache_size)
  end

  # The connection `lease` describes (see [.adopt]).
  def initialize(lease: Lease)
    @config = lease.config
    @io = lease.io
    @reader = MessageReader.new(lease.io)
    @statements = StatementCache.new(lease.statements)
    @parameters = lease.parameters
    @process_id = lease.process_id
    @secret = lease.secret
    @notifications = lease.notifications
    @channels = lease.channels
    @unsure = lease.unsure
    @route = lease.route
  end

  # Makes a connection of `lease` in the calling task: the session goes on
  # where [#release] left it (idle, its prepared statements kept). A lease
  # is used once.
  def self.adopt(lease: Lease) -> Connection = Connection.new(lease)

  # Gives the session up as a [PG::Lease], for another task to [.adopt];
  # this object is closed for use afterwards (its socket stays open). Only
  # an idle session is given up: one in a transaction is rolled back
  # first. Returns nil, closing the socket, when the session cannot go on:
  # it is closed or broken, or the rollback failed. Never raises.
  def release -> Lease?
    return nil if @closed
    begin
      exec("ROLLBACK") unless @status == "I"
    rescue Exception
      close_io
      @closed = true
      return nil
    end
    if @status != "I"
      close
      return nil
    end
    @closed = true
    Lease.new(@io, @config, @process_id, @secret, @parameters, @statements.snapshot,
              @notifications, @channels, @unsure, @route)
  end

  # The run-time parameters the server reported (server_version,
  # TimeZone, client_encoding, standard_conforming_strings, ...),
  # kept up to date.
  def parameters -> Hash[String, String] = @parameters

  # The server's version, as [server_version] reports it (`"17.11 (Debian
  # 17.11-0+deb13u1)"`).
  def server_version -> String = @parameters["server_version"]? || ""

  # The server process serving this session.
  def process_id -> Int = @process_id

  # :nodoc:
  # Where a CancelRequest for the session goes (set when it connects).
  def cancel_route=(route: CancelRoute) -> Void
    @route = route
    nil
  end

  # `:idle`, `:in_transaction` or `:failed` (a transaction an error
  # aborted), as of the last time the server was ready.
  def transaction_status -> Symbol
    case @status
    when "T" then :in_transaction
    when "E" then :failed
    else :idle
    end
  end

  # Listens to `channel` (LISTEN, the name quoted as an identifier, so
  # that any name of 1 to 63 bytes works, case kept): the server then
  # sends this session every NOTIFY on it, which [#wait_for_notify] and
  # [#notifications] give. Listening again to a channel does nothing. A
  # LISTEN takes effect when its transaction commits (at once outside
  # one). Raises [ArgumentError] for an empty name, one holding a NUL, or
  # one of 64 bytes or more (the server would cut it to 63).
  #
  # Listen through this method rather than `exec("LISTEN ...")`: only it
  # is tracked ([#listening?]), which [PG::Pool] relies on.
  def listen(channel: String) -> Void
    exec("LISTEN #{Connection.quote_ident(channel)}")
    @channels = @channels.add(channel)
  end

  # Stops listening to `channel` (UNLISTEN). Notifications already
  # received stay queued. Raises [ArgumentError] for a name [#listen]
  # refuses.
  def unlisten(channel: String) -> Void
    exec("UNLISTEN #{Connection.quote_ident(channel)}")
    @channels = @channels.delete(channel)
    @unsure = true unless @status == "I"
  end

  # Stops listening to every channel (`UNLISTEN *`), whichever way it was
  # listened to. Notifications already received stay queued.
  def unlisten_all -> Void
    exec("UNLISTEN *")
    @channels = Set[String].new
    @unsure = @status != "I"
  end

  # Whether a LISTEN through [#listen] may be in force on this session: a
  # channel listened to and not unlistened, or an [#unlisten] in a
  # transaction (a rollback would undo it). A LISTEN sent with [#exec]
  # is not seen.
  def listening? -> Bool = !@channels.empty? || @unsure

  # Sends a notification on `channel` with `payload` (`pg_notify`, as a
  # query with parameters: no quoting). Inside a transaction it is
  # delivered when the transaction commits, and not at all if it rolls
  # back. Raises [ArgumentError] for a channel name [#listen] refuses,
  # and [PG::ServerError] for what the server refuses (a payload of 8000
  # bytes or more).
  def notify(channel: String, payload: String = "") -> Void
    ::check_channel(channel)
    query("SELECT pg_notify($1, $2)", [channel, payload])
    nil
  end

  # The notifications received so far and not yet taken, oldest first,
  # taking them: those that arrived while the connection ran queries, or
  # read by [#wait_for_notify] along with others. Does not read the
  # socket.
  def notifications -> Array[Notification]
    all = @notifications
    @notifications = []
    all
  end

  # The next notification: a queued one (see [#notifications]), else one
  # read from the socket, waiting up to `timeout` (`nil`: without limit).
  # Returns nil when `timeout` passes first. Only the calling task waits;
  # [Task.timeout] and `cancel` interrupt the wait. An interrupted wait
  # leaves the connection usable when it was waiting between messages, as
  # it nearly always is; one interrupted in the middle of a message (the
  # rest of it not arrived yet) closes the connection, as [#exec] says.
  # So does `timeout` passing in the middle of a message, which raises
  # [PG::ConnectionError]: a server that sends part of a message and
  # stalls does not hold the caller past `timeout`.
  # The server delivers notifications only between transactions: inside
  # one ([#transaction]), this waits for its timeout.
  # Raises [PG::ConnectionError] when the connection is closed or breaks,
  # [PG::ServerError] when the server ends the session (an administrator's
  # `pg_terminate_backend`, a shutdown).
  def wait_for_notify(timeout: Duration? = nil) -> Notification?
    if (n = @notifications.first?)
      @notifications = @notifications.shift
      return n
    end
    raise ConnectionError.new("the connection is closed") if @closed
    deadline = timeout ? Time.monotonic + timeout : nil
    loop do
      left = deadline ? deadline - Time.monotonic : nil
      ready = begin
        # (A time left below zero waits not at all.)
        @io.wait_readable(timeout: left)
      rescue IOError, SystemCallError => e
        broken(e.message)
      end
      return nil unless ready
      # A whole message, or the connection closed: never out of step. The
      # message is read under what is left of the deadline (a server that
      # sends part of one and stalls does not hold the caller past it);
      # bytes already buffered are read without waiting, so a message
      # whole in the buffer is never cut. (Only the reading: a notice
      # handler it calls is not bounded.)
      done = false
      m = begin
        r = read_message(deadline) ||
            raise ConnectionError.new("a message from the server was not whole when the timeout passed: " +
                                      "the connection is closed")
        done = true
        take(r)
      ensure
        unless done
          @closed = true
          close_io
        end
      end
      case m
      in nil then nil
      in Backend::ErrorResponse(fields:)
        # A FATAL error: the server ends the session.
        refused(fields)
      else
        unexpected(m, "while waiting for a notification")
      end
      # (A notification that came with it stays queued.)
      if (e = @notice_error)
        @notice_error = nil
        raise e
      end
      if (n = @notifications.first?)
        @notifications = @notifications.shift
        return n
      end
    end
  end

  # `name` as an SQL identifier: double-quoted, a `"` in it doubled.
  # Raises [ArgumentError] for an empty name, one holding a NUL, or one of
  # 64 bytes or more (the server cuts an identifier to 63 bytes).
  #
  # ```
  # PG::Connection.quote_ident("jobs")      # => "\"jobs\""
  # PG::Connection.quote_ident("a\"b c")    # => "\"a\"\"b c\""
  # ```
  def self.quote_ident(name: String) -> String
    ::check_channel(name)
    "\"#{name.gsub("\"", "\"\"")}\""
  end

  # Calls the block with each notice or warning the server sends (its
  # fields, as [PG::ServerError#fields]); without a handler they are dropped.
  def on_notice(&handler: (Hash[String, String]) -> Void) -> Void
    @notice_handler = handler
  end

  # Runs `sql` (one statement or several, separated by `;`) with the
  # simple protocol, and returns the last statement's result. Raises
  # [PG::ServerError] for the first statement that fails, after which the
  # statements after it do not run (and, outside a transaction block, the
  # ones before it stay done). Takes no parameters: use [#query] for
  # values.
  #
  # A call that does not read the server's whole answer (its task was
  # cancelled or timed out, or a notice handler raised) closes the
  # connection: what is left of the answer would be taken for the next
  # one's. When it was cut by a cancellation or a [Task.timeout] after
  # the statement was sent, a CancelRequest first asks the server to stop
  # the statement (pg#14), on a connection of its own to the same server
  # (over TLS with the session's own configuration when the session went
  # over TLS, never in clear then): the server does not go on running it.
  # The cancel takes at most `CANCEL_TIMEOUT` (5 seconds), added to the
  # interrupted call's time only when the server does not answer it; a
  # cancel that cannot be sent is dropped, and the call raises its own
  # Cancelled or Timeout as before.
  def exec(sql: String) -> Result = exec_all(sql).last? || Result.new([], [], "")

  # As [#exec], but returns every statement's result, in order.
  def exec_all(sql: String) -> Array[Result]
    results: Array[Result] = []
    columns: Array[Field] = []
    rows: Array[Row] = []
    converse(Frontend.query(sql)) do |m|
      case m
      in Backend::RowDescription(fields:)
        columns = fields
        rows = []
      in Backend::DataRow(values:)
        rows = rows.push(Row.new(columns, values))
      in Backend::CommandComplete(tag:)
        # The server dropped every prepared statement.
        @statements.clear if tag == "DISCARD ALL" || tag == "DEALLOCATE ALL"
        results = results.push(Result.new(columns, rows, tag))
        columns = []
        rows = []
      in Backend::EmptyQueryResponse
        results = results.push(Result.new([], [], ""))
      else
        unexpected(m, "in a simple query")
      end
    end
    results
  end

  # Runs one statement with the extended protocol, `params` standing for
  # `$1`, `$2`, ...: each is sent apart from the SQL, so no value needs
  # quoting. A parameter may be nil (NULL), an Int, a Float, a String, a
  # Bool, Bytes (bytea), a Time (sent in UTC), a Date (its ISO text), a
  # Decimal (its text) or a Symbol (its name);
  # another raises [ArgumentError]. Raises [PG::ServerError] when the
  # statement fails. A call cut short closes the connection, as [#exec]
  # says.
  #
  # The statement is prepared once and kept, by its SQL text, among the
  # connection's `statement_cache_size` most recently used. One the server
  # no longer has (SQLSTATE 26000), or says changed under it (0A000, a
  # table altered) outside a transaction, is prepared again and the call
  # retried once; inside a transaction the 0A000 is raised (the
  # transaction is aborted), and the next call prepares it again.
  def query(sql: String, params: Array[Object?] = []) -> Result = run_query(sql, params, true)

  private def run_query(sql: String, params: Array[Object?], again: Bool) -> Result
    values = params.map { |p| Connection.encode(p) }
    types = Connection.types(params)
    # (A statement is prepared with its parameters' types: the array
    # types are part of its key, so that `SELECT $1` given a `text[]`
    # and then a `timestamptz[]` are two statements. Lengths are not.)
    key = types.empty? ? sql : "#{sql}\x00#{types.join(",")}"
    columns: Array[Field] = []
    rows: Array[Row] = []
    tag = ""
    cached = @statements.enabled? ? @statements.lookup(key) : nil
    name = cached || (@statements.enabled? ? @statements.next_name : "")
    # The messages that may raise (a NUL in the SQL, too many parameters)
    # are made before the cache gives up the statements it evicts.
    body = (cached ? Bytes.new : Frontend.parse(name, sql, types)) + Frontend.bind("", name, values) +
           Frontend.describe_portal("") + Frontend.execute("") + Frontend.sync
    @statements.make_room if @statements.enabled? && !cached
    b = Bytes::Builder.new
    @statements.take_closes.each { |n| b << Frontend.close_statement(n) }
    b << body
    parsed = false
    begin
      converse(b.to_bytes) do |m|
        case m
        in Backend::ParseComplete
          parsed = true
        in Backend::BindComplete | Backend::NoData | Backend::EmptyQueryResponse | Backend::CloseComplete
          nil
        in Backend::RowDescription(fields:)
          columns = fields
        in Backend::DataRow(values:)
          rows = rows.push(Row.new(columns, values))
        in Backend::CommandComplete(tag: t)
          tag = t
        else
          unexpected(m, "in an extended query")
        end
      end
    rescue ServerError => e
      if cached
        stale = case e.code
                when "26000"
                  @statements.drop(key)
                  true
                when "0A000"
                  @statements.forget(key)
                  @status == "I"
                else
                  false
                end
        return run_query(sql, params, false) if stale && again
      end
      raise e
    ensure
      # Prepared on the server, whatever came after (an execution error, a
      # notice handler's exception): the statement stays good.
      @statements.add(key, name) if !cached && parsed && name != ""
    end
    # The server dropped every prepared statement.
    @statements.clear if tag == "DISCARD ALL" || tag == "DEALLOCATE ALL"
    Result.new(columns, rows, tag)
  end

  # How many prepared statements the connection keeps.
  def prepared_statements -> Int = @statements.size

  # Runs the block in a transaction: BEGIN, then COMMIT when the block
  # returns, or ROLLBACK when it raises (the exception goes on) or leaves
  # otherwise (`return`, `break`). When a statement in the block failed
  # and the block went on after rescuing it, the server rolls the
  # transaction back at COMMIT; this raises [PG::ServerError] (SQLSTATE 25P02)
  # then, rather than returning as if it had been committed. Returns the
  # block's value. Raises [PG::TransactionError] when the connection is in
  # a transaction already: there are no nested transactions (no
  # savepoints) yet.
  def transaction[R](&: (Connection) -> R) -> R
    unless @status == "I"
      raise TransactionError.new("already in a transaction: nested transactions are not supported yet")
    end
    exec("BEGIN")
    settled = false
    result = begin
      r = yield self
      settled = true
      r
    rescue Exception => e
      settled = true
      rollback_quietly
      raise e
    ensure
      # `return` or `break` out of the block.
      rollback_quietly unless settled
    end
    if exec("COMMIT").command_tag == "ROLLBACK"
      raise ServerError.new({ "S" => "ERROR", "V" => "ERROR", "C" => "25P02",
                        "M" => "the transaction was aborted by an earlier error and rolled back" })
    end
    result
  end

  # A parameter's text, as the server reads it (nil for NULL). A Time is
  # sent in UTC, so that a `timestamp` column (without zone), which drops
  # the offset, keeps the instant as [PG::Row#time] reads it back. An
  # [Array] is a one-dimensional PostgreSQL array (`encode_array`). A
  # [String] holding a NUL, which PostgreSQL's text cannot hold, raises
  # [ArgumentError] (the value not shown), an array's element too: before
  # anything is sent, so the connection and its transaction go on (#68).
  #
  # ```
  # PG::Connection.encode(true)                # => b"t"
  # PG::Connection.encode(b"\x01\xff")       # => b"\\x01ff"
  # PG::Connection.encode(-Float::INFINITY)    # => b"-Infinity"
  # PG::Connection.encode([1, nil, 3])         # => b"{1,NULL,3}"
  # PG::Connection.encode("a\0b")              # raises ArgumentError
  # ```
  def self.encode(value: Object?) -> Bytes?
    text = case value
           in nil then return nil
           in Array => xs then return encode_array(xs)
           in Bool => b then b ? "t" : "f"
           in Int => i then i.to_s
           in Float => f
             if f.nan?
               "NaN"
             elsif f.infinite?
               f > 0 ? "Infinity" : "-Infinity"
             else
               f.to_s
             end
           in String => s
             # (Not quoted: it may be anything a request carried.)
             raise ArgumentError.new("a String parameter holding a NUL, which PostgreSQL's text cannot hold") if s.include?("\0")
             s
           in Symbol => s then s.to_s
           in Bytes => b then return "\\x#{b.hex}".to_bytes
           in Time => t then t.utc.iso8601(6)
           # (Its ISO text, which a `date` column, or `$1::date`, takes.)
           in Date => d then d.to_s
           # (Its text, the scale kept, which a `numeric` column, or
           # `$1::numeric`, takes exactly.)
           in Decimal => d then d.to_s
           # (A document: its compact text, which a `jsonb` or `json`
           # column, or `$1::jsonb`, takes.)
           in JSON::Value => v then JSON.generate(v)
           else raise ArgumentError.new("a parameter of class #{value.class.name}: " +
                                        "give nil, Int, Float, String, Bool, Bytes, Time, Date, Decimal, Symbol or an Array of one of them; or a JSON::Value")
           end
    text.to_bytes
  end

  # An array parameter's text: `{1,2,3}`, each element as `encode` gives
  # it, double-quoted when it is empty, spells NULL or holds `,`, `{`,
  # `}`, `"`, `\` or white space (`"` and `\` escaped with `\`); a nil
  # element is NULL, the empty array `{}`. Raises [ArgumentError] for
  # elements of different classes or a nested array (one dimension for
  # now).
  #
  # ```
  # PG::Connection.encode_array(["a", "b,c", "d\"e", ""])   # => b"{a,\"b,c\",\"d\\\"e\",\"\"}"
  # PG::Connection.encode_array(Array[Int].new)            # => b"{}"
  # ```
  def self.encode_array(xs: Array[Object?]) -> Bytes
    element_class(xs)
    b = Bytes::Builder.new
    b << "{"
    xs.each_with_index do |x, i|
      b << "," if i > 0
      if t = encode(x)
        if quote?(t)
          b << "\""
          t.each { |c| b << 92 if c == 34 || c == 92; b << c }
          b << "\""
        else
          b << t
        end
      else
        b << "NULL"
      end
    end
    b << "}"
    b.to_bytes
  end

  # The class of an array parameter's elements, nil when it has none but
  # nils; [ArgumentError] for mixed classes or a nested array.
  def self.element_class(xs: Array[Object?]) -> Type[Object]?
    first: Type[Object]? = nil
    at = 0
    xs.each_with_index do |x, i|
      case x
      in nil then nil
      in Array then raise ArgumentError.new("a nested array at index #{i}: array parameters are one-dimensional")
      # (Not an element: a `JSON::Value` is a parameter of its own.)
      in JSON::Value then raise ArgumentError.new("a JSON::Value at index #{i}: an array of documents is not a parameter (send one document, or a jsonb array: a JSON::Value::Array)")
      else
        if f = first
          unless x.class == f
            raise ArgumentError.new("an array parameter of mixed classes: index #{at} is a #{f.name}, index #{i} a #{x.class.name}")
          end
        else
          first = x.class
          at = i
        end
      end
      nil
    end
    first
  end

  # The type OIDs the Parse message gives for `params`, up to the last
  # one that is not 0: the array's type for an array of Ints (`int8[]`
  # 1016), Bools (`bool[]` 1000), Bytes (`bytea[]` 1001), Dates
  # (`date[]` 1182) or Decimals (`numeric[]` 1231), each one type with one
  # meaning, so that a
  # bare `unnest($1)` resolves without a cast; 0 for the rest, as for
  # every scalar: the server infers the type from the context, so that
  # the column decides (a `float8[]` would compare a `numeric` or `real`
  # column as double precision, a `text[]` would not meet a `uuid`,
  # `date`, enum or `citext` column, a `timestamptz[]` would shift a
  # `timestamp` column's values by the session's time zone). An empty
  # array or one of nils is 0 too.
  #
  # ```
  # PG::Connection.types([1, [1, 2], "a"])   # => [0, 1016]
  # PG::Connection.types([Array[Int].new])   # => []
  # ```
  def self.types(params: Array[Object?]) -> Array[Int]
    oids = params.map do |p|
      case p
      in Array => xs
        c = element_class(xs)
        if c == Int then 1016
        elsif c == Bool then 1000
        elsif c == Bytes then 1001
        elsif c == Date then 1182
        elsif c == Decimal then 1231
        else 0
        end
      else 0
      end
    end
    n = oids.size
    n -= 1 while n > 0 && oids[n - 1] == 0
    oids.take(n)
  end

  # The bytes that make an array element quoted.
  QUOTED = [b",", b"{", b"}", b"\"", b"\\", b" ", b"\t", b"\n", b"\v", b"\f", b"\r"]

  private def self.quote?(t: Bytes) -> Bool
    return true if t.empty? || (t.size == 4 && t.decode.downcase == "null")
    QUOTED.any? { |c| t.include?(c) }
  end

  # Sends `request` and reads the answer up to ReadyForQuery, giving the
  # block every message but errors (the first is raised at the end, after
  # the connection is in step again) and ReadyForQuery. Anything that
  # leaves before the end (a cancelled task, an exception) closes the
  # connection; a cancellation or a timeout after the request was sent
  # sends a CancelRequest first (`cancel_quietly`). The connection is
  # closed even then: it runs nothing afterwards, so a cancel that comes
  # late cannot stop a next statement.
  private def converse(request: Bytes, &handle: (Backend) -> Void) -> Void
    error: ServerError? = nil
    done = false
    sent = false
    begin
      # Inside: a write cut short leaves part of a request on the wire.
      send(request)
      sent = true
      loop do
        m = begin
          receive
        rescue ConnectionError => e
          # A FATAL error just before the server hung up says more.
          raise error || e
        end
        case m
        in Backend::ErrorResponse(fields:)
          error = error || ServerError.new(fields)
        in Backend::ReadyForQuery(status:)
          @status = status
          done = true
          break
        else
          handle.call(m)
        end
      end
    rescue Task::Cancelled, Task::Timeout => interrupted
      # Cut short while the server runs the statement: ask it to stop
      # (pg#14) before the session's socket is closed below.
      cancel_quietly if sent && !done
      raise interrupted
    ensure
      unless done
        @closed = true
        close_io
      end
    end
    raise error if error
    if (e = @notice_error)
      @notice_error = nil
      raise e
    end
  end

  # Rolls back the transaction `#transaction` began, unless the
  # connection broke (the server then rolls it back itself). Errors are
  # dropped: the block's exception, if any, is the one to report.
  private def rollback_quietly -> Void
    return if @closed
    exec("ROLLBACK")
  rescue Exception
  end

  # Whether [#close] was called, or the connection broke.
  def closed? -> Bool = @closed

  # Whether the session goes over TLS (see `sslmode` in [PG.connect]).
  def tls? -> Bool = @io.is_a?(TLSSocket)

  # Ends the session: tells the server, and closes the socket. Closing a
  # closed connection does nothing.
  def close -> Void
    return if @closed
    @closed = true
    begin
      @io.write(Frontend.terminate)
    rescue Exception
      # Even a cancelled task closes the socket.
    end
    close_io
  end

  # The startup exchange: authentication, then the session's parameters,
  # up to the first ReadyForQuery. Called by [PG.connect].
  def startup -> Void
    # The readers of `PG::Row` read ISO dates and floats in full.
    params = { "user" => @config.user, "client_encoding" => "UTF8", "DateStyle" => "ISO",
               "extra_float_digits" => "3" }
    if (db = @config.database)
      params = params.put("database", db)
    end
    if (app = @config.application_name)
      params = params.put("application_name", app)
    end
    # (The server takes the parameters above over the same settings in
    # `options`, whatever their order: the readers keep what they rely
    # on.)
    if (opts = @config.options)
      params = params.put("options", opts)
    end
    send(Frontend.startup(params))
    authenticate
    loop do
      case m = receive
      in Backend::ReadyForQuery(status:)
        @status = status
        break
      in Backend::BackendKeyData(process_id:, secret:)
        @process_id = process_id
        @secret = secret
      in Backend::NegotiateProtocolVersion
        # Protocol 3.0 asked for and spoken; only options went unknown.
        nil
      in Backend::ErrorResponse(fields:)
        refused(fields)
      else
        unexpected(m, "while starting")
      end
    end
  end

  # Whether the server is authenticated by the connection itself: a unix
  # socket, or TLS verified against roots. Only then may it ask for md5 or
  # for no authentication without `require_auth` (pg#49).
  private def server_authenticated? -> Bool
    return true if @config.host.start_with?("/")
    tls = @io.as?(TLSSocket)
    !tls.nil? && tls.verified?
  end

  # Refuses the method `method` the server asked for when `require_auth`
  # does not list it or, without `require_auth`, when the server is not
  # authenticated and the method would give it something (an md5 value
  # to guess the password from, or the session without any check).
  private def allow_method(method: Symbol) -> Void
    shown = {password: "a password in clear", md5: "md5 password authentication",
             scram_sha_256: "SCRAM-SHA-256", none: "no authentication"}[method]? || method.to_s
    if (allowed = @config.require_auth)
      return if allowed.include?(method)
      raise AuthenticationError.new("the server asked for #{shown}, which require_auth does not allow")
    end
    return unless method == :md5 || method == :none
    return if server_authenticated?
    name = method == :md5 ? "md5" : "none"
    raise AuthenticationError.new("the server asked for #{shown} over a connection that does not authenticate it " +
                                  "(a unix socket, or TLS verified against roots); pass require_auth: \"#{name}\" to allow it")
  end

  private def authenticate -> Void
    scram: Scram? = nil
    # Whether the server sent its SCRAM challenge (SASLContinue).
    continued = false
    # Whether the server asked for any method before AuthenticationOk.
    asked = false
    loop do
      case m = receive
      in Backend::AuthenticationOk
        if (s = scram) && !s.verified?
          raise AuthenticationError.new("the server ended SCRAM without proving that it knows the password")
        end
        allow_method(:none) unless asked
        break
      in Backend::AuthenticationCleartextPassword
        refuse_after_sasl(scram)
        asked = true
        allow_method(:password)
        unless @config.host.start_with?("/") || @config.allow_cleartext
          raise AuthenticationError.new("the server asks for the password in clear over TCP; " +
                                        "pass allow_cleartext: true to send it so")
        end
        send(Frontend.password(password))
      in Backend::AuthenticationMD5Password(salt:)
        refuse_after_sasl(scram)
        asked = true
        allow_method(:md5)
        send(Frontend.password(Connection.md5_password(@config.user, password, salt)))
      in Backend::AuthenticationSASL(mechanisms:)
        unless mechanisms.include?(Scram::MECHANISM)
          raise AuthenticationError.new("the server offers SASL with #{mechanisms.join(", ")}, " +
                                        "and this client speaks #{Scram::MECHANISM} only")
        end
        refuse_after_sasl(scram)
        asked = true
        allow_method(:scram_sha_256)
        s = Scram.new(password, min_iterations: @config.min_scram_iterations,
                      max_iterations: @config.max_scram_iterations)
        scram = s
        send(Frontend.sasl_initial_response(Scram::MECHANISM, s.client_first.to_bytes))
      in Backend::AuthenticationSASLContinue(data:)
        s = scram || unexpected(m, "before SASL started")
        # One challenge per exchange: answering more would hash again
        # for as long as the server asks.
        unexpected(m, "after the client's proof") if continued
        continued = true
        send(Frontend.sasl_response(s.client_final(text(data)).to_bytes))
      in Backend::AuthenticationSASLFinal(data:)
        s = scram || unexpected(m, "before SASL started")
        s.verify(text(data))
      in Backend::AuthenticationOther(code:)
        raise AuthenticationError.new("the server asks for an authentication method this client " +
                                      "does not speak (code #{code}: Kerberos, GSSAPI or SSPI)")
      in Backend::ErrorResponse(fields:)
        refused(fields)
      else
        unexpected(m, "while authenticating")
      end
    end
  end

  # The server refused the session: it closes the connection.
  private def refused(fields: Hash[String, String]) -> Nothing
    @closed = true
    close_io
    raise ServerError.new(fields)
  end

  # A server that started SCRAM and then asks for a weaker method is not
  # followed.
  private def refuse_after_sasl(scram: Scram?) -> Void
    raise AuthenticationError.new("the server changed the authentication method during SCRAM") if scram
  end

  private def password -> String | Bytes::Secret
    @config.password || raise(AuthenticationError.new("the server asks for a password, and none was given"))
  end

  private def text(data: Bytes) -> String
    data.decode? || raise(ProtocolError.new("SASL data that is not UTF-8"))
  end

  # Sends `bytes`; a failure breaks the connection.
  private def send(bytes: Bytes) -> Void
    raise ConnectionError.new("the connection is closed") if @closed
    @io.write(bytes)
  rescue IOError, SystemCallError => e
    broken(e.message)
  end

  # The next message that is not about the session itself (see
  # `#receive_one`).
  private def receive -> Backend
    loop do
      if (m = receive_one)
        return m
      end
    end
  end

  # The next message, or nil for one about the session itself: parameter
  # changes are recorded, notices go to the handler, and notifications to
  # the queue.
  private def receive_one -> Backend? = take(read_message(nil) || raise ConnectionError.new("the server closed the connection"))

  # The next message as read, whatever it is about, or nil when
  # `deadline` passes before it is whole ([PG::MessageReader#read_within]:
  # the stream is then out of step). Raises [PG::ConnectionError] (and
  # closes the connection) at the end of the stream, for bytes that are
  # not the protocol, or when the socket fails.
  private def read_message(deadline: Duration?) -> Backend?
    @reader.read_within(deadline)
  rescue ConnectionError => e
    # The end of the stream, or bytes that are not the protocol.
    @closed = true
    close_io
    raise e
  rescue IOError, SystemCallError => e
    broken(e.message)
  end

  # `m`, or nil for a message about the session itself, which it records
  # (see `#receive_one`).
  private def take(m: Backend) -> Backend?
    case m
    in Backend::ParameterStatus(name:, value:)
      @parameters = @parameters.put(name, value)
      nil
    in Backend::NoticeResponse(fields:)
      begin
        @notice_handler&.call(fields)
      rescue StandardError => e
        # Raised once the answer is read, to keep the stream in step.
        @notice_error = @notice_error || e
      end
      nil
    in Backend::NotificationResponse(process_id:, channel:, payload:)
      @notifications = @notifications.push(Notification.new(channel, payload, process_id))
      nil
    else
      m
    end
  end

  # Sends a CancelRequest for the statement the session runs (pg#14), on
  # a connection of its own to the server the session reached, over TLS
  # with the session's own configuration when the session went over TLS
  # (never in clear then), within [CANCEL_TIMEOUT], even in a task being
  # cancelled. Never raises: a cancel that cannot be sent leaves the
  # statement to the server, as closing the session does.
  private def cancel_quietly -> Void
    return if @process_id == 0 || @secret.empty?
    config = @config
    route = @route
    request = Frontend.cancel_request(@process_id, @secret)
    Task.uncancellable do
      begin
        Task.timeout(CANCEL_TIMEOUT) { Connection.send_cancel(config, route, request) }
      rescue Exception
        nil
      end
    end
    nil
  end

  # :nodoc:
  # Sends `request` (a CancelRequest) as `cancel_quietly` says, and waits
  # for the server to close the connection, so that the cancel is taken
  # before the session's socket closes. Raises what the socket raises.
  def self.send_cancel(config: Config, route: CancelRoute, request: Bytes) -> Void
    io: IO = if config.host.start_with?("/")
               UNIXSocket.new("#{config.host}/.s.PGSQL.#{config.port}")
             elsif (peer = route.peer)
               TCPSocket.connect(peer)
             else
               Socket.tcp(config.host, config.port)
             end
    begin
      if (t = route.tls) && (sock = io.as?(TCPSocket))
        sock.write(Frontend.ssl_request)
        # (A server that will not speak TLS gets nothing: the key never
        # goes in clear for a session that went over TLS.)
        return nil unless sock.read_bytes(1) == b"S"
        io = TLSSocket.connect(sock, config.host, t)
      end
      io.write(request)
      io.flush
      loop do
        break if io.read_bytes(1).empty?
      end
    ensure
      begin
        io.close
      rescue IOError, SystemCallError
      end
    end
    nil
  end

  private def broken(message: String) -> Nothing
    @closed = true
    close_io
    raise ConnectionError.new(message)
  end

  private def close_io -> Void
    @io.close
  rescue IOError, SystemCallError
  end

  private def unexpected(m: Backend, context: String) -> Nothing
    @closed = true
    close_io
    raise ProtocolError.new("unexpected #{m.class.name.split("::").last} #{context}")
  end
end
