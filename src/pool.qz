# Connections shared by many tasks, on any worker. An idle connection is
# kept as a `PG::Lease` (its socket and its session's state, Shareable);
# a task that needs one takes a lease and makes a `PG::Connection` of it
# in its own task, and gives it back when done.
#
#     PG::Pool.open("postgres://app@localhost/shop", size: 8) do |pool|
#       Task.scope do |s|
#         8.times { |i| s.spawn { pool.query("SELECT $1::int", [i]) } }
#       end
#       pool.transaction { |c| c.exec("UPDATE stock SET n = n - 1") }
#     end
#
# The rules:
#
# - Connections are opened when needed, up to `size`. A call waits for a
#   free one at most `checkout_timeout` when it is given (then it raises
#   `PG::PoolTimeout`); the work itself is not bounded by it.
# - The work runs in the caller's task, and its exceptions are the
#   caller's. When it returns, the connection goes back to the pool if it
#   is idle (a transaction the work left open is rolled back first);
#   otherwise (broken, or a call cut short by cancellation or a timeout)
#   it is closed, and the pool opens another when one is needed.
# - A connection given back stops listening (`UNLISTEN *`, when
#   `PG::Connection#listening?`), and the notifications it received are
#   dropped: a listener uses a connection of its own (`PG.connect`).
# - A connection idle for longer than `idle_timeout` (by default 5
#   minutes; nil keeps them) is closed, so the pool shrinks after a
#   burst. The pool has no task of its own: the stale connections are
#   found when a connection is taken or given back. A pool nobody uses
#   keeps them until its next use. The most recently given back is
#   taken first, so that the others can age.
# - Waiting calls are not served in the order they began waiting: a
#   connection given back goes to whichever call takes it first, a new
#   one included. `checkout_timeout` bounds each call's whole wait.
# - `#close`, or the end of `.open`'s block, closes the idle connections
#   and those given back later; calls waiting for one raise
#   `PG::ConnectionError` ("pool closed").
class Pool
  include Shareable

  # An idle connection, and when it was given back (`Time.monotonic`).
  data Idle = (lease: Lease, since: Duration)

  @config: Config
  @size: Int
  @checkout_timeout: Duration?
  @idle_timeout: Duration?
  # The idle connections, the most recently given back last.
  @idle: Atom[Array[Idle]]
  # A token per connection given back or dropped: it wakes a waiter, who
  # then takes or opens one. Closed by `#close`.
  @freed: Channel[Nil]
  # How many connections exist, idle or in use.
  @opened: Atom[Int]

  # A pool of up to `size` connections to the server `url` names (see
  # `PG.connect`); close it with `#close`. `.open` closes it for you.
  def initialize(url: String, @size: Int = 10, @checkout_timeout: Duration? = nil,
                 @idle_timeout: Duration? = 5.minutes)
    Pool.check(size, idle_timeout)
    @config = parse_url(url)
    @idle = Atom[Array[Idle]].new([])
    @freed = Channel[Nil].new(size)
    @opened = Atom[Int].new(0)
  end

  # As `.new(url)`, with a `PG::Config`.
  def initialize(@config: Config, @size: Int = 10, @checkout_timeout: Duration? = nil,
                 @idle_timeout: Duration? = 5.minutes)
    Pool.check(size, idle_timeout)
    @idle = Atom[Array[Idle]].new([])
    @freed = Channel[Nil].new(size)
    @opened = Atom[Int].new(0)
  end

  # :nodoc:
  def self.check(size: Int, idle_timeout: Duration?) -> Void
    raise ArgumentError.new("a pool of #{size} connections") if size < 1
    if idle_timeout && idle_timeout <= 0.seconds
      raise ArgumentError.new("an idle timeout is positive, not #{idle_timeout}")
    end
    nil
  end

  # Runs the block with a new pool (see `.new`), and closes the pool when
  # the block ends. Returns the block's value.
  def self.open[R](url: String, size: Int = 10, checkout_timeout: Duration? = nil,
                   idle_timeout: Duration? = 5.minutes, &: (Pool) -> R) -> R
    pool = Pool.new(url, size:, checkout_timeout:, idle_timeout:)
    begin
      yield pool
    ensure
      pool.close
    end
  end

  # Runs the block with a connection of the pool, in the calling task, and
  # returns its value (see the class's rules). The connection is the
  # pool's: a block that calls its `PG::Connection#release` takes it out
  # of the pool.
  def with[R](&: (Connection) -> R) -> R
    conn = checkout
    begin
      yield conn
    ensure
      checkin(conn)
    end
  end

  # `PG::Connection#exec` on a connection of the pool.
  def exec(sql: String) -> Result = with { |c| c.exec(sql) }

  # `PG::Connection#query` on a connection of the pool.
  def query(sql: String, params: Array[Object?] = []) -> Result = with { |c| c.query(sql, params) }

  # `PG::Connection#transaction` on a connection of the pool.
  def transaction[R](&: (Connection) -> R) -> R
    with { |c| c.transaction { |tx| yield tx } }
  end

  # How many connections are open, idle or in use.
  def size -> Int = @opened.get

  # Whether `#close` was called.
  def closed? -> Bool = @freed.closed?

  # Closes the idle connections now, and the others when they are given
  # back; later calls raise `PG::ConnectionError`. Closing again does
  # nothing.
  def close -> Void
    @freed.close
    drain
  end

  private def checkout -> Connection
    limit = @checkout_timeout
    deadline = limit ? Time.monotonic + limit : nil
    loop do
      raise ConnectionError.new("pool closed") if @freed.closed?
      reap
      if (entry = take)
        return Connection.adopt(entry.lease)
      end
      n = @opened.get
      if n < @size
        next unless @opened.compare_and_set(n, n + 1)
        begin
          return Connection.open(@config)
        rescue Exception => e
          @opened.update { |k| k - 1 }
          raise e
        end
      end
      wait_for_token(deadline)
    end
  end

  # The most recently given back idle connection, taken out; nil for none.
  private def take -> Idle?
    got: Idle? = nil
    @idle.update do |stack|
      got = stack.last?
      got ? stack[0...(stack.size - 1)] : stack
    end
    got
  end

  # Waits for a connection to be given back or dropped, until `deadline`
  # (`Time.monotonic`; nil for no limit), then raises `PoolTimeout`;
  # returns at once when the pool closed (the caller sees it). A token
  # left when a wait times out stays for another waiter.
  private def wait_for_token(deadline: Duration?) -> Void
    unless deadline
      begin
        @freed.receive
      rescue Channel::Closed
        nil
      end
      return
    end
    left = deadline - Time.monotonic
    timed_out = left <= 0.seconds
    unless timed_out
      begin
        Channel.select do |s|
          s.receive(@freed) { |_| nil }
          s.after(left) { timed_out = true }
        end
      rescue Channel::Closed
        return
      end
    end
    raise PoolTimeout.new("no connection free within #{@checkout_timeout}") if timed_out
    nil
  end

  private def checkin(conn: Connection) -> Void
    quiet(conn)
    lease = conn.release
    unless lease
      @opened.update { |k| k - 1 }
      wake
      return
    end
    if @freed.closed?
      discard(lease)
      return
    end
    @idle.update { |stack| stack.push(Idle.new(lease, Time.monotonic)) }
    # (A close since the check above has drained already: drain again.)
    if @freed.closed?
      drain
      return
    end
    wake
    reap
  end

  # Closes the idle connections given back longer than `idle_timeout` ago.
  private def reap -> Void
    limit = @idle_timeout
    return if limit.nil?
    cutoff = Time.monotonic - limit
    stale: Array[Idle] = []
    @idle.update do |stack|
      stale = stack.select { |e| e.since <= cutoff }
      stale.empty? ? stack : stack.reject { |e| e.since <= cutoff }
    end
    stale.each do |e|
      discard(e.lease)
      wake
    end
  end

  # Closes every idle connection.
  private def drain -> Void
    taken: Array[Idle] = []
    @idle.update do |stack|
      taken = stack
      Array[Idle].new
    end
    taken.each { |e| discard(e.lease) }
  end

  # A connection given back stops listening (`UNLISTEN *`, after rolling
  # back a transaction left open, which would undo it), and the
  # notifications it received are dropped: its next user gets none it
  # did not ask for. One that cannot is closed.
  private def quiet(conn: Connection) -> Void
    return if conn.closed?
    if conn.listening?
      conn.exec("ROLLBACK") unless conn.transaction_status == :idle
      conn.unlisten_all
    end
    conn.notifications
    nil
  rescue Exception
    conn.close
  end

  # Tells a waiter, if any, that a connection may be taken or opened.
  private def wake -> Void
    @freed.try_send(nil)
  rescue Channel::Closed
  end

  # Closes an idle connection; the count drops even when the caller is
  # cancelled meanwhile.
  private def discard(lease: Lease) -> Void
    Task.uncancellable { Connection.adopt(lease).close }
  ensure
    @opened.update { |k| k - 1 }
  end
end
