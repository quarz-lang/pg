# What a statement returned: its columns and rows (none for a statement
# that returns no rows), and its command tag.
class Result
  include Shareable

  @columns: Array[Field]
  @rows: Array[Row]
  @command_tag: String

  # A result of [rows] with [columns], as the server tagged it.
  def initialize(@columns: Array[Field], @rows: Array[Row], @command_tag: String); end

  # The columns, in order.
  def columns -> Array[Field] = @columns

  # The columns' names, in order.
  def column_names -> Array[String] = @columns.map(&:name)

  # The rows.
  def rows -> Array[Row] = @rows

  # The command tag (`SELECT 2`, `INSERT 0 1`, `UPDATE 3`, `CREATE TABLE`),
  # or `""` for an empty query.
  def command_tag -> String = @command_tag

  # How many rows the statement inserted, updated, deleted, selected,
  # moved, fetched, copied or merged, from its tag; nil for a statement
  # that does not count rows.
  #
  # ```
  # PG::Result.new([], [], "INSERT 0 3").affected   # => 3
  # PG::Result.new([], [], "CREATE TABLE").affected  # => nil
  # ```
  def affected -> Int?
    m = @command_tag.match(/\A(?:INSERT \d+|UPDATE|DELETE|SELECT|MOVE|FETCH|COPY|MERGE) (\d+)\z/)
    m && m[1]&.to_i
  end

  # The number of rows.
  def size -> Int = @rows.size

  # Whether there are no rows.
  def empty? -> Bool = @rows.empty?

  # Each row.
  def each(&: (Row) -> Void) -> Void = @rows.each { |r| yield r }

  # The first row, or nil.
  def first? -> Row? = @rows.first?

  # The rows as hashes from column names to text values.
  def to_a -> Array[Hash[String, String?]] = @rows.map(&:to_h)
end

# A row of a result: each column's value as the server's text, and typed
# readers on top. A column is named by its index from 0 or by its name
# (the first column of that name).
#
# The readers decode PostgreSQL's text format: [int] for int2/int4/int8
# (and any integer text), [float] for float4/float8/numeric
# (NaN, Infinity), [bool] for `t`/`f`, [bytes] for bytea's hex form,
# [time] for timestamp, timestamptz and date (a timestamp without zone,
# and a date at midnight, are taken as UTC), [decimal] for numeric (a
# [Decimal], the scale kept), [date] for date (a [Date];
# [time] keeps reading one as a Time at midnight UTC), [json] for json/jsonb or
# any JSON text (a [JSON::Value]), [string] for anything. Each raises
# [PG::NullError] on NULL; its `?` form gives nil instead. A value a
# reader cannot decode raises [ArgumentError].
class Row
  include Shareable

  @columns: Array[Field]
  @values: Array[Bytes?]

  # A row of `values`, one per column of [columns].
  def initialize(@columns: Array[Field], @values: Array[Bytes?]); end

  # The columns.
  def columns -> Array[Field] = @columns

  # The number of columns.
  def size -> Int = @values.size

  # The column's text, or nil for NULL. Raises [IndexError] for a column
  # the row does not have.
  def [](column: Int | String) -> String?
    raw(column)&.decode
  end

  # The column's value as an Int.
  def int(column: Int | String) -> Int = int?(column) || null(column)

  # As [#int], nil for NULL.
  def int?(column: Int | String) -> Int?
    (t = text(column)) ? Row.parse_int(t) : nil
  end

  # The column's value as a Float.
  def float(column: Int | String) -> Float = float?(column) || null(column)

  # As [#float], nil for NULL.
  def float?(column: Int | String) -> Float?
    (t = text(column)) ? Row.parse_float(t) : nil
  end

  # The column's value as text.
  def string(column: Int | String) -> String = string?(column) || null(column)

  # As [#string], nil for NULL.
  def string?(column: Int | String) -> String? = self[column]

  # The column's value as a Bool.
  def bool(column: Int | String) -> Bool
    v = bool?(column)
    v.nil? ? null(column) : v
  end

  # As [#bool], nil for NULL.
  def bool?(column: Int | String) -> Bool?
    case text(column)
    in nil then nil
    in "t" then true
    in "f" then false
    in String => t then raise ArgumentError.new("not a bool: #{t.inspect}")
    end
  end

  # The column's value as Bytes: bytea's hex form decoded, or the text's
  # bytes for another type.
  def bytes(column: Int | String) -> Bytes = bytes?(column) || null(column)

  # As [#bytes], nil for NULL.
  def bytes?(column: Int | String) -> Bytes?
    v = raw(column)
    return nil unless v
    type_of(column) == Types::BYTEA ? Row.parse_bytea(v) : v
  end

  # The column's value as a Time.
  def time(column: Int | String) -> Time = time?(column) || null(column)

  # As [#time], nil for NULL.
  def time?(column: Int | String) -> Time?
    (t = text(column)) ? Row.parse_time(t) : nil
  end

  # The column's value as a Date: a [date] column's (or any text in
  # PostgreSQL's ISO form, `2026-11-20`). What a Date cannot hold raises
  # [ArgumentError] naming the value: `infinity`, `-infinity`, a year
  # beyond 9999 or a BC date (read such a column as a string).
  def date(column: Int | String) -> Date = date?(column) || null(column)

  # As [#date], nil for NULL.
  def date?(column: Int | String) -> Date?
    (t = text(column)) ? Row.parse_date(t) : nil
  end

  # The column's value as a Decimal: a `numeric` column's (or any text
  # in its form), its scale kept (`19.990` reads with scale 3). What a
  # Decimal cannot hold raises [ArgumentError] naming the value: NaN,
  # Infinity, -Infinity, a value beyond its limits (1,000 fraction
  # digits, 10,000 digits); read such a column as a string.
  def decimal(column: Int | String) -> Decimal = decimal?(column) || null(column)

  # As [#decimal], nil for NULL.
  def decimal?(column: Int | String) -> Decimal?
    (t = text(column)) ? Row.parse_decimal(t) : nil
  end

  # The column's text parsed as a JSON document ([JSON.parse]), a
  # [json] or `jsonb` column's, or any column's holding JSON: SQL's NULL
  # raises [PG::NullError], while the document `null` is
  # [JSON::Value::Null]. Raises [ArgumentError] for text that is not JSON,
  # as the readers do for a value they cannot decode (the
  # [JSON::ParseError] its cause). A number becomes an [Int], an exact [Integer]
  # beyond an [Int], or a [Float] for a fraction or an exponent: `jsonb`
  # keeps any decimal exactly, so a fraction read and written back may
  # change (`0.1` stays `0.1`, a fraction of 20 digits does not).
  def json(column: Int | String) -> JSON::Value = json?(column) || null(column)

  # As [#json], nil for SQL's NULL.
  def json?(column: Int | String) -> JSON::Value?
    t = text(column) || return nil
    begin
      JSON.parse(t)
    rescue JSON::ParseError => e
      raise ArgumentError.new("column #{column.inspect} is not JSON: #{e.message}")
    end
  end

  # The column's array as Ints (a NULL element as nil). Raises
  # [ArgumentError] for an array of more than one dimension, as the
  # readers do for text that is not their type.
  def ints(column: Int | String) -> Array[Int?] = ints?(column) || null(column)

  # As [#ints], nil for a NULL array.
  def ints?(column: Int | String) -> Array[Int?]? = elements?(column) { |t| Row.parse_int(t) }

  # The column's array as Floats.
  def floats(column: Int | String) -> Array[Float?] = floats?(column) || null(column)

  # As [#floats], nil for a NULL array.
  def floats?(column: Int | String) -> Array[Float?]? = elements?(column) { |t| Row.parse_float(t) }

  # The column's array as text.
  def strings(column: Int | String) -> Array[String?] = strings?(column) || null(column)

  # As [#strings], nil for a NULL array.
  def strings?(column: Int | String) -> Array[String?]? = elements?(column) { |t| t }

  # The column's array as Bools.
  def bools(column: Int | String) -> Array[Bool?] = bools?(column) || null(column)

  # As [#bools], nil for a NULL array.
  def bools?(column: Int | String) -> Array[Bool?]?
    elements?(column) do |t|
      case t
      in "t" then true
      in "f" then false
      else raise ArgumentError.new("not a bool: #{t.inspect}")
      end
    end
  end

  # The column's array as Times.
  def times(column: Int | String) -> Array[Time?] = times?(column) || null(column)

  # As [#times], nil for a NULL array.
  def times?(column: Int | String) -> Array[Time?]? = elements?(column) { |t| Row.parse_time(t) }

  # The column's array as Decimals (`numeric[]`), each element as
  # [#decimal] reads one.
  def decimals(column: Int | String) -> Array[Decimal?] = decimals?(column) || null(column)

  # As [#decimals], nil for a NULL array.
  def decimals?(column: Int | String) -> Array[Decimal?]? = elements?(column) { |t| Row.parse_decimal(t) }

  # The column's array as Dates (`date[]`), each element as [#date]
  # reads one.
  def dates(column: Int | String) -> Array[Date?] = dates?(column) || null(column)

  # As [#dates], nil for a NULL array.
  def dates?(column: Int | String) -> Array[Date?]? = elements?(column) { |t| Row.parse_date(t) }

  # The row as a hash from column names to text values.
  def to_h -> Hash[String, String?]
    h: Hash[String, String?] = {}
    @columns.each_with_index { |c, i| h = h.put(c.name, @values[i]&.decode) }
    h
  end

  def inspect -> String = "#<PG::Row #{to_h.inspect}>"

  def to_s -> String = inspect

  # Text as an Int (`-42`).
  def self.parse_int(text: String) -> Int
    raise ArgumentError.new("not an integer: #{text.inspect}") unless text.match?(/\A-?[0-9]+\z/)
    text.to_i
  rescue OverflowError
    raise ArgumentError.new("an integer beyond Int: #{text}")
  end

  # Text as a Float, with PostgreSQL's spellings of the special values.
  def self.parse_float(text: String) -> Float
    case text
    when "NaN" then Float::NAN
    when "Infinity" then Float::INFINITY
    when "-Infinity" then -Float::INFINITY
    else
      raise ArgumentError.new("not a number: #{text.inspect}") unless text.match?(/\A-?[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?\z/)
      text.to_f
    end
  end

  # An array's text output (`{1,NULL,"a b"}`) as its elements' text, nil
  # for NULL: quoted elements unescaped. Elements are separated by `,`,
  # as for every built-in type but `box` (whose arrays use `;`). Raises [ArgumentError] for an
  # array of more than one dimension or with explicit bounds
  # (`[0:1]={1,2}`).
  #
  # ```
  # PG::Row.parse_array(b"{1,NULL,\"a,\\\"b\"}")   # => ["1", nil, "a,\"b"]
  # PG::Row.parse_array(b"{}")                     # => []
  # ```
  def self.parse_array(raw: Bytes) -> Array[String?]
    n = raw.size
    raise ArgumentError.new("an array with explicit bounds: #{raw.decode.inspect}") if n > 0 && raw[0] == 91
    raise ArgumentError.new("not an array: #{raw.decode.inspect}") unless n >= 2 && raw[0] == 123 && raw[n - 1] == 125
    out = Array::Builder[String?].new
    return out.to_a if n == 2
    i = 1
    # (The next backslash and quote, each searched again only once
    # passed.)
    bs = raw.index(b"\\", 0) || n
    q = -1
    loop do
      raise ArgumentError.new("malformed array: #{raw.decode.inspect}") if i >= n - 1
      raise ArgumentError.new("an array of more than one dimension: read it with `[]`") if raw[i] == 123
      if raw[i] == 34
        b = Bytes::Builder.new
        i += 1
        loop do
          q = raw.index(b"\"", i) || n if q < i
          raise ArgumentError.new("an unterminated quoted element: #{raw.decode.inspect}") unless q < n - 1
          bs = raw.index(b"\\", i) || n if bs < i
          if bs < q
            b << raw.slice(i, bs - i)
            b << raw[bs + 1]
            i = bs + 2
          else
            b << raw.slice(i, q - i)
            i = q + 1
            break
          end
        end
        out << b.to_bytes.decode
      else
        start = i
        i = raw.index(b",", i) || n - 1
        i = n - 1 if i > n - 1
        raise ArgumentError.new("malformed array: #{raw.decode.inspect}") if i == start
        t = raw.slice(start, i - start).decode
        out << (i - start == 4 && t == "NULL" ? nil : t)
      end
      break if i >= n - 1
      raise ArgumentError.new("malformed array: #{raw.decode.inspect}") unless raw[i] == 44
      i += 1
    end
    out.to_a
  end

  # bytea's hex output (`\x0aff`) as Bytes.
  #
  # ```
  # PG::Row.parse_bytea(b"\\x0aff")   # => b"\n\xff"
  # ```
  def self.parse_bytea(raw: Bytes) -> Bytes
    unless raw.start_with?(b"\\x")
      raise ArgumentError.new("bytea not in hex form (set bytea_output = 'hex')")
    end
    hex = raw.slice(2, raw.size - 2).decode
    raise ArgumentError.new("malformed bytea") unless hex.match?(/\A(?:[0-9a-fA-F]{2})*\z/)
    Bytes.from_hex(hex)
  end

  # A timestamp, timestamptz or date in PostgreSQL's ISO output
  # (`2024-03-05 14:07:09.5+09`, `2024-03-05`): a value without an offset
  # is UTC.
  #
  # ```
  # PG::Row.parse_time("2024-03-05 14:07:09+09").utc_offset   # => 32400
  # PG::Row.parse_time("2024-03-05")                          # => 2024-03-05 00:00:00 UTC
  # ```
  def self.parse_time(text: String) -> Time
    m = text.match(/\A(\d{4,}-\d\d-\d\d)(?: (\d\d:\d\d:\d\d(?:\.\d+)?)([-+]\d\d(?::?\d\d){0,2})?)?\z/)
    if text == "infinity" || text == "-infinity"
      raise ArgumentError.new("#{text}: a Time cannot hold it (read the column as a string)")
    end
    raise ArgumentError.new("not a timestamp: #{text.inspect}") unless m
    date = m[1] || ""
    clock = m[2] || "00:00:00"
    offset = m[3]
    zone = if offset
             sign = offset[0]
             parts = offset[1, offset.size - 1].delete(":")
             parts = parts + "00" if parts.size == 2
             raise ArgumentError.new("an offset with seconds: #{text.inspect}") if parts.size > 4
             "#{sign}#{parts[0, 2]}:#{parts[2, 2]}"
           else
             "Z"
           end
    Time.parse("#{date}T#{clock}#{zone}")
  end

  # A `numeric` in PostgreSQL's output (`19.990`, `-0.5`, `1500`), its
  # scale kept. Raises [ArgumentError] naming the value for what a
  # Decimal cannot hold (NaN, Infinity, -Infinity, a value beyond
  # its limits) or for text that is not a decimal.
  #
  # ```
  # PG::Row.parse_decimal("19.990").scale   # => 3
  # ```
  def self.parse_decimal(text: String) -> Decimal
    if text == "NaN" || text == "Infinity" || text == "-Infinity"
      raise ArgumentError.new("#{text}: a Decimal cannot hold it (read the column as a string)")
    end
    # (`parse?` raises only past a limit: the value shown, with its
    # reason; nil is text that is not a decimal.)
    d = begin
          Decimal.parse?(text)
        rescue ArgumentError => e
          raise ArgumentError.new("#{Row.shown(text)}: #{e.message.sub(/: ".*\z/m, "")} (read the column as a string)")
        end
    d || raise ArgumentError.new("not a decimal: #{Row.shown(text).inspect}")
  end

  # `text`, cut to 40 characters (an error names a value of 10,000
  # digits so).
  def self.shown(text: String) -> String = text.size > 40 ? text[0, 40] + "..." : text

  # A date in PostgreSQL's ISO output (`2026-11-20`). Raises
  # [ArgumentError] for what a Date cannot hold (`infinity`,
  # `-infinity`, a year beyond 9999, a BC date: `0044-03-15 BC`), or for
  # text that is not a date.
  #
  # ```
  # PG::Row.parse_date("2026-11-20")   # => 2026-11-20
  # ```
  def self.parse_date(text: String) -> Date
    if text == "infinity" || text == "-infinity"
      raise ArgumentError.new("#{text}: a Date cannot hold it (read the column as a string)")
    end
    if text.end_with?(" BC")
      raise ArgumentError.new("#{text}: a Date cannot hold a BC date (read the column as a string)")
    end
    if text.match?(/\A\d{5,}-\d\d-\d\d\z/)
      raise ArgumentError.new("#{text}: a Date holds the years 1 to 9999 (read the column as a string)")
    end
    Date.parse?(text) || raise ArgumentError.new("not a date: #{text.inspect}")
  end

  private def index(column: Int | String) -> Int
    case column
    in Int => i
      raise IndexError.new("no column #{i}: the row has #{@values.size}") unless i >= 0 && i < @values.size
      i
    in String => name
      @columns.index { |c| c.name == name } || raise(IndexError.new("no column #{name.inspect}"))
    end
  end

  private def raw(column: Int | String) -> Bytes? = @values[index(column)]

  private def text(column: Int | String) -> String? = raw(column)&.decode

  private def elements?[T](column: Int | String, &f: (String) -> T) -> Array[T?]?
    v = raw(column) || return nil
    Row.parse_array(v).map { |x| x ? f.call(x) : nil }
  end

  private def type_of(column: Int | String) -> Int = @columns[index(column)].type

  private def null(column: Int | String) -> Nothing
    raise NullError.new("column #{column.inspect} is NULL")
  end
end

# OIDs of the built-in types the readers know.
module Types
  BOOL = 16
  BYTEA = 17
  INT8 = 20
  INT2 = 21
  INT4 = 23
  TEXT = 25
  FLOAT4 = 700
  FLOAT8 = 701
  VARCHAR = 1043
  DATE = 1082
  TIMESTAMP = 1114
  TIMESTAMPTZ = 1184
  NUMERIC = 1700
  UUID = 2950
  JSON = 114
  JSONB = 3802
end
