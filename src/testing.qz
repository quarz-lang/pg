# A PostgreSQL server for tests: the one PG_TEST_URL names, or else a
# throwaway cluster this module makes with the server's own programs
# (`initdb` and `pg_ctl` from /usr/lib/postgresql/*/bin), in a temporary
# directory, on a random port of 127.0.0.1 and a private socket
# directory, with SCRAM-SHA-256 for every connection, removed when it is
# stopped. For tests only: it starts processes and writes files, and its
# password comes from the default random generator, which a test's
# `srand` makes predictable.
#
# A cluster's URL spells its host, port, user, password and database and
# `?sslmode=prefer` (append parameters with `&`; a later `sslmode` wins),
# so libpq's variables in the developer's environment do not change them
# (pg#71). `PGSSLROOTCERT`, `PGOPTIONS`, `PGAPPNAME` and
# `PGCONNECT_TIMEOUT` still reach a test, as for any URL that omits them:
# `PGSSLROOTCERT=system` makes `PG.connect` refuse the URL
# ([ArgumentError]: the system's roots need `verify-full`), and a path
# has the server verified against it when the session goes over TLS.
# PG_TEST_URL's URL is the user's and is left as given.
#
# ```quarz no_run
# PG::Testing.with_cluster do |url|
#   conn = PG.connect(url)
#   conn.exec("CREATE TABLE t (id int)")
# end
# ```
#
# In a [Test::Case], start one for the class and omit its tests when
# there is none:
#
# ```quarz no_run
# class UsersTest < Test::Case
#   SERVER = Atom[PG::Testing::Server | String].new("not started")
#
#   def self.startup
#     SERVER.set(PG::Testing.start_or_reason)
#   end
#
#   def self.shutdown
#     case SERVER.get
#     in PG::Testing::Server => s then s.stop
#     else nil
#     end
#   end
#
#   def url -> String
#     case SERVER.get
#     in PG::Testing::Server => s then s.url
#     in String => why then omit(why)
#     end
#   end
# end
# ```
module Testing
  # Neither PG_TEST_URL nor the server's programs to make a cluster.
  class Unavailable < Error
  end

  # A server to test against: PG_TEST_URL's, or a cluster of ours.
  class Server
    include Shareable

    # A connection URL, with the password.
    @url: String
    # The cluster's directory (nil: PG_TEST_URL's server).
    @dir: String?
    @bin: String

    # (Made by [PG::Testing.start].)
    def initialize(@url: String, @dir: String?, @bin: String); end

    # A URL to connect to it, with its password.
    def url -> String = @url

    # The server as text, the URL's password left out as [PG::Config#inspect]
    # does (a failed test prints its values): `[FILTERED]` in its place,
    # in the user part and in each `password` parameter (its name decoded,
    # as [PG.parse_url] reads it), and as the whole URL when it is not one
    # [PG.parse_url] can read.
    #
    # ```
    # PG::Testing::Server.new("postgres://ann:pw@127.0.0.1:5432/shop", nil, "/usr/bin").inspect
    # # => "#<PG::Testing::Server url: \"postgres://ann:[FILTERED]@127.0.0.1:5432/shop\", dir: nil>"
    # ```
    def inspect -> String
      "#<PG::Testing::Server url: #{Server.masked(@url)}, dir: #{@dir.inspect}>"
    end

    # :nodoc:
    # `url` as [#inspect] shows it: quoted, its password replaced by
    # `[FILTERED]`; `[FILTERED]` alone for a URL [PG.parse_url] refuses
    # (a malformed one, an unknown parameter, a bad value: never shown in
    # part). Read as [PG.parse_url] reads it (`read_url`,
    # [PG::Config.url_parts]), not by [PG.parse_url] itself, which reads
    # the environment for defaults: a value's text must
    # not, so that `to_s` can run where the environment cannot, as a
    # compile-time statement's argument.
    def self.masked(url: String) -> String
      parts = begin
        # (Every check [PG.parse_url] makes: an unknown parameter, which
        # may be a password, or a bad value refuses the URL too.)
        read_url(url)
        Config.url_parts(url)
      rescue ArgumentError
        return "[FILTERED]"
      end
      text = "#{parts.scheme}://"
      if (name = parts.user_text)
        text = text + name
        text = text + ":[FILTERED]" if parts.password
        text = text + "@"
      end
      text = text + parts.middle
      if (pairs = parts.pairs)
        shown = pairs.map { |p| p.name == "password" ? "#{p.raw.partition("=")[0]}=[FILTERED]" : p.raw }
        text = "#{text}?#{shown.join("&")}"
      end
      text.inspect
    end

    def to_s -> String = inspect

    # Whether it is a cluster of ours (whose `pg_hba.conf` has the lines
    # `start` was given), not PG_TEST_URL's server.
    def ours? -> Bool = !@dir.nil?

    # The directory of its unix socket, for a cluster of ours.
    def socket_dir -> String? = @dir

    # The password in the URL.
    def password -> String
      # (A URL's password is a String.)
      # (Not from the environment: the server's own URL, read as written.)
      config, _ = read_url(@url)
      p = config.password
      p.is_a?(String) ? p : ""
    end

    # The port in the URL.
    def port -> Int
      config, _ = read_url(@url)
      config.port
    end

    # Stops a cluster of ours and removes its directory; nothing for
    # PG_TEST_URL's.
    def stop -> Void
      dir = @dir
      return unless dir
      Process.run("#{@bin}/pg_ctl", "-D", "#{dir}/data", "-m", "immediate", "-w", "stop")
      Process.run("rm", "-rf", dir)
    end
  end

  # A server: PG_TEST_URL's when it is set, else a new cluster, whose
  # superuser is `quarz` and whose `pg_hba.conf` starts with the lines
  # `hba` gives (`"host all md5_user 127.0.0.1/32 md5"`), before
  # SCRAM-SHA-256 for every connection (`hba` does nothing to
  # PG_TEST_URL's server: check [Server#ours?] before relying on it).
  # Raises [Unavailable] when there is neither.
  #
  # Given a `certificate` (PEM, the server's own first) and its
  # `private_key` (PEM), it is always a new cluster, with TLS on (`ssl =
  # on`, those files as `ssl_cert_file` and `ssl_key_file`): PG_TEST_URL's
  # server is not used, and a `hostssl` line in `hba` takes effect.
  def self.start(*, hba: Array[String] = [], certificate: String? = nil, private_key: String? = nil) -> Server
    if certificate.nil? != private_key.nil?
      raise ArgumentError.new("give both certificate and private_key, or neither")
    end
    if (env = ENV["PG_TEST_URL"]?) && !env.empty? && certificate.nil?
      return Server.new(env, nil, "")
    end
    initdb = Dir.glob("/usr/lib/postgresql/*/bin/initdb").sort.last
    unless initdb
      raise Unavailable.new(certificate ? "no initdb to make a server with TLS" : "no PG_TEST_URL and no initdb to make a server")
    end
    bin = File.dirname(initdb)
    dir = "#{Dir.tmpdir}/quarz-pg-#{Process.pid}-#{Random.rand(1_000_000_000)}"
    run("mkdir", "-m", "700", dir)
    begin
      password = Random.bytes(12).hex
      File.write("#{dir}/password", password)
      run("#{bin}/initdb", "-D", "#{dir}/data", "-U", "quarz", "--auth=scram-sha-256",
          "--pwfile=#{dir}/password", "-E", "UTF8", "--locale=C")
      # (The first matching line wins.)
      lines = hba + ["local all all scram-sha-256", "host all all 127.0.0.1/32 scram-sha-256"]
      File.write("#{dir}/data/pg_hba.conf", lines.join("\n") + "\n")
      ssl = ""
      if certificate && private_key
        # The server refuses a key file others may read: 0600 before the
        # key is written.
        File.write("#{dir}/server.crt", certificate)
        run("touch", "#{dir}/server.key")
        run("chmod", "600", "#{dir}/server.key")
        File.write("#{dir}/server.key", private_key)
        ssl = "ssl = on\nssl_cert_file = '#{quote(dir)}/server.crt'\nssl_key_file = '#{quote(dir)}/server.key'\n"
      end
      port = start_on_a_free_port(bin, dir, ssl)
      Server.new("postgres://quarz:#{password}@127.0.0.1:#{port}/postgres?sslmode=prefer", dir, bin)
    rescue Exception => e
      # (A start that timed out may have left the server running.)
      if File.exist?("#{dir}/data/postmaster.pid")
        Process.run("#{bin}/pg_ctl", "-D", "#{dir}/data", "-m", "immediate", "-w", "stop")
      end
      Process.run("rm", "-rf", dir)
      raise e
    end
  end

  # `start`, or why there is no server: for a test class's `startup`,
  # whose tests then `omit` with the reason.
  def self.start_or_reason(*, hba: Array[String] = [], certificate: String? = nil,
                           private_key: String? = nil) -> Server | String
    start(hba: hba, certificate: certificate, private_key: private_key)
  rescue Unavailable => e
    e.message
  end

  # Runs the block with the URL of a server (`start`), and stops it
  # afterwards (`hba`, `certificate` and `private_key` as for `start`).
  def self.with_cluster[R](*, hba: Array[String] = [], certificate: String? = nil,
                           private_key: String? = nil, &: (String) -> R) -> R
    server = start(hba: hba, certificate: certificate, private_key: private_key)
    begin
      yield server.url
    ensure
      server.stop
    end
  end

  # (The settings go in `postgresql.auto.conf`, not pg_ctl's `-o`, which
  # a shell splits: a directory with a space would not do.)
  private def self.start_on_a_free_port(bin: String, dir: String, extra: String) -> Int
    5.times do
      port = Random.rand(20000..60000)
      conf = "unix_socket_directories = '#{quote(dir)}'\nlisten_addresses = '127.0.0.1'\nport = #{port}\n" + extra
      File.write("#{dir}/data/postgresql.auto.conf", conf)
      out = Process.run("#{bin}/pg_ctl", "-D", "#{dir}/data", "-l", "#{dir}/log", "-w", "-t", "60", "start")
      return port if out.success?
    end
    log = File.exist?("#{dir}/log") ? File.read("#{dir}/log").lines.last(10).join : ""
    raise Error.new("the throwaway server did not start; its log ended with:\n#{log}")
  end

  # `text` for inside a quoted string of postgresql.conf.
  private def self.quote(text: String) -> String = text.gsub("'", "''")

  private def self.run(*command: String) -> Void
    out = Process.run(*command)
    raise Error.new("#{command.first} failed: #{out.stderr}") unless out.success?
  end
end
