require "test"

# LISTEN/NOTIFY against a real server (PG::Testing).
class NotifyTest < Test::Case
  SERVER = Atom[PG::Testing::Server | String].new("not started")

  def self.startup
    SERVER.set(PG::Testing.start_or_reason)
  end

  def self.shutdown
    case SERVER.get
    in PG::Testing::Server => s then s.stop
    else nil
    end
  end

  def url -> String
    case SERVER.get
    in PG::Testing::Server => s then s.url
    in String => why then omit(why)
    end
  end

  # Runs the block with a listener and a notifier, closed afterwards.
  def pair(&: (PG::Connection, PG::Connection) -> Void) -> Void
    listener = PG.connect(url)
    notifier = PG.connect(url)
    begin
      yield listener, notifier
    ensure
      listener.close
      notifier.close
    end
  end

  def test_a_notification_from_another_session
    pair do |listener, notifier|
      assert_false(listener.listening?)
      listener.listen("jobs")
      assert_true(listener.listening?)
      notifier.notify("jobs", "42")
      n = listener.wait_for_notify(timeout: 5.seconds) || flunk("no notification")
      assert_equal("jobs", n.channel)
      assert_equal("42", n.payload)
      assert_equal(notifier.process_id, n.process_id)
      notifier.notify("jobs")
      assert_equal("", listener.wait_for_notify(timeout: 5.seconds)&.payload)
    end
  end

  def test_notifications_that_arrive_during_queries_are_queued
    pair do |listener, notifier|
      listener.listen("q")
      notifier.notify("q", "one")
      notifier.notify("q", "two")
      # The server sends them while the listener is idle: the next
      # answers read them first.
      listener.exec("SELECT pg_sleep(0.05)")
      listener.exec("SELECT 1")
      queued = listener.notifications
      assert_equal(["one", "two"], queued.map(&:payload))
      assert_equal([], listener.notifications)
      notifier.notify("q", "three")
      listener.exec("SELECT pg_sleep(0.05)")
      listener.exec("SELECT 1")
      # wait_for_notify takes a queued one without reading.
      assert_equal("three", listener.wait_for_notify(timeout: 0.seconds)&.payload)
    end
  end

  # pg#52: a connection to a stand-in server that answers the startup
  # (no authentication, idle), then, for each of `parts`, waits its
  # pause and writes its bytes, and holds the connection until `release`
  # gets a value (or 5 seconds pass).
  def stand_in(parts: Array[[Duration, Bytes]], release: Channel[Nil], &: (PG::Connection) -> Void) -> Void
    server = TCPServer.new("127.0.0.1", 0)
    port = server.local_address.port
    Task.scope do |scope|
      peer_task = scope.spawn do
        peer = server.accept
        size = peer.read_bytes(4)
        peer.read_bytes(((size[0] << 24) | (size[1] << 16) | (size[2] << 8) | size[3]) - 4)
        peer.write(PG::Wire.frame('R'.ord, b"\x00\x00\x00\x00") + PG::Wire.frame('Z'.ord, b"I"))
        parts.each do |part|
          Task.sleep(part[0])
          peer.write(part[1])
        end
        begin
          Task.timeout(5.seconds) { release.receive? }
        rescue Task::Timeout
        end
        peer.close
      end
      conn = PG.connect(host: "127.0.0.1", port: port, user: "ann", sslmode: :disable, require_auth: "none")
      begin
        yield conn
      ensure
        conn.close
        release.try_send(nil)
        peer_task.await
      end
    end
    server.close
  end

  # A NotificationResponse from process 7 on `channel` with `payload`.
  def notification(channel: String, payload: String) -> Bytes
    body = Bytes::Builder.new
    body << b"\x00\x00\x00\x07" << channel.to_bytes << 0 << payload.to_bytes << 0
    PG::Wire.frame('A'.ord, body.to_bytes)
  end

  def test_a_message_cut_by_the_timeout_closes_the_connection
    release = Channel[Nil].new(1)
    stand_in([[0.seconds, notification("jobs", "x").slice(0, 1)]], release) do |conn|
      started = Time.monotonic
      e = assert_raise(PG::ConnectionError) { conn.wait_for_notify(timeout: 300.ms) }
      assert_equal("a message from the server was not whole when the timeout passed: the connection is closed", e.message)
      # (The stand-in holds the connection for 5 seconds.)
      assert_true(Time.monotonic - started < 3.seconds)
      assert_true(conn.closed?)
    end
  end

  def test_a_message_in_two_parts_within_the_timeout
    whole = notification("jobs", "split")
    release = Channel[Nil].new(1)
    stand_in([[0.seconds, whole.slice(0, 6)], [100.ms, whole.slice(6, whole.size - 6)]], release) do |conn|
      n = conn.wait_for_notify(timeout: 5.seconds) || raise "no notification"
      assert_equal(["jobs", "split", 7], [n.channel, n.payload, n.process_id])
      assert_false(conn.closed?)
    end
  end

  # A message already whole when the time left is none is read, not cut:
  # the stand-in writes it at once, and the wait has no time left at all.
  def test_a_whole_message_at_the_deadline_is_read
    release = Channel[Nil].new(1)
    stand_in([[0.seconds, notification("jobs", "now")]], release) do |conn|
      # (Until the bytes are there: a timeout of zero does not wait for them.)
      n = conn.wait_for_notify(timeout: 0.seconds)
      tries = 0
      while n.nil? && tries < 100
        Task.sleep(10.ms)
        tries += 1
        n = conn.wait_for_notify(timeout: 0.seconds)
      end
      assert_equal("now", (n || raise "no notification").payload)
      assert_false(conn.closed?)
    end
  end

  # Exactly `n` bytes from `io`, or nil when it ends first.
  def self.read_exact(io: IO, n: Int) -> Bytes?
    out = Bytes::Builder.new
    while out.size < n
      part = io.read_bytes(n - out.size)
      return nil if part.empty?
      out << part
    end
    out.to_bytes
  end

  # Over TLS: the stand-in sends the first byte of a notification in a
  # TLS record of its own, then the rest in a second record, of which a
  # proxy forwards only the first 3 bytes: a message cut short inside a
  # TLS record that never completes. The time left bounds the wait for
  # the record's rest too (IO#wait_readable on a TLS socket answers for
  # plaintext, not for the record's bytes).
  def test_a_message_cut_inside_a_tls_record_closes_the_connection
    cert = TLS::Testing.self_signed(["127.0.0.1"])
    root = File.join(Dir.tmpdir, "pg-notify-#{Process.pid}-#{Random.rand(1_000_000_000)}.pem")
    File.write(root, cert.certificate)
    upstream = TCPServer.new("127.0.0.1", 0)
    front = TCPServer.new("127.0.0.1", 0)
    # Set once the client is connected: the proxy cuts the next record.
    cut = Atom[Bool].new(false)
    go = Channel[Nil].new(1)
    release = Channel[Nil].new(1)
    whole = notification("jobs", "tls")
    begin
      Task.scope do |scope|
        server_task = scope.spawn do
          raw = upstream.accept
          NotifyTest.read_exact(raw, 8)
          raw.write("S")
          tls = TLSSocket.accept(raw, TLS::ServerConfig.new(certificate: cert.certificate, private_key: cert.private_key))
          size = NotifyTest.read_exact(tls, 4) || b"\x00\x00\x00\x04"
          NotifyTest.read_exact(tls, ((size[0] << 24) | (size[1] << 16) | (size[2] << 8) | size[3]) - 4)
          tls.write(PG::Wire.frame('R'.ord, b"\x00\x00\x00\x00") + PG::Wire.frame('Z'.ord, b"I"))
          go.receive?
          tls.write(whole.slice(0, 1))
          tls.write(whole.slice(1, whole.size - 1))
          begin
            Task.timeout(5.seconds) { release.receive? }
          rescue Task::Timeout
          end
          raw.close
        end
        proxy_task = scope.spawn do
          client = front.accept
          server = TCPSocket.new("127.0.0.1", upstream.local_address.port)
          Task.scope do |inner|
            inner.spawn do
              begin
                loop do
                  part = client.read_bytes(16_384)
                  break if part.empty?
                  server.write(part)
                end
              rescue IOError, SystemCallError
                nil
              end
              nil
            end
            # Record by record from the server; once `cut` is set, the
            # first application-data record goes whole and the second
            # only in part.
            seen = 0
            begin
              # (The answer to the SSLRequest, before TLS: one byte.)
              client.write(NotifyTest.read_exact(server, 1) || b"")
              loop do
                head = NotifyTest.read_exact(server, 5) || break
                body = NotifyTest.read_exact(server, (head[3] << 8) | head[4]) || break
                if cut.get && head[0] == 23
                  seen += 1
                  if seen == 2
                    client.write(head.slice(0, 3))
                    next
                  end
                end
                client.write(head + body)
              end
            rescue IOError, SystemCallError
              nil
            end
            client.close
            server.close
          end
        end
        conn = PG.connect(host: "127.0.0.1", port: front.local_address.port, user: "ann", sslmode: :verify_full,
                          sslrootcert: root, require_auth: "none")
        begin
          assert_true(conn.tls?)
          cut.set(true)
          go.send(nil)
          started = Time.monotonic
          e = assert_raise(PG::ConnectionError) { conn.wait_for_notify(timeout: 500.ms) }
          assert_equal("a message from the server was not whole when the timeout passed: the connection is closed", e.message)
          assert_true(Time.monotonic - started < 3.seconds)
          assert_true(conn.closed?)
        ensure
          conn.close
          release.try_send(nil)
          server_task.await
          proxy_task.await
        end
      end
    ensure
      upstream.close
      front.close
      File.delete(root) if File.exist?(root)
    end
  end

  def test_a_timeout_returns_nil_and_the_connection_goes_on
    pair do |listener, _|
      listener.listen("quiet")
      assert_nil(listener.wait_for_notify(timeout: 50.ms))
      assert_false(listener.closed?)
      assert_equal(1, listener.exec("SELECT 1").rows[0].int(0))
    end
  end

  def test_task_timeout_around_a_wait_leaves_the_connection_usable
    pair do |listener, notifier|
      listener.listen("t")
      assert_raise(Task::Timeout) do
        Task.timeout(50.ms) { listener.wait_for_notify }
      end
      assert_false(listener.closed?)
      assert_equal(2, listener.exec("SELECT 2").rows[0].int(0))
      notifier.notify("t", "after")
      assert_equal("after", listener.wait_for_notify(timeout: 5.seconds)&.payload)
    end
  end

  def test_a_cancelled_wait_leaves_the_connection_usable
    leased = Atom[PG::Lease?].new(nil)
    target = url
    listening = Channel[Bool].new(1)
    Task.scope do |s|
      waiter = s.spawn do
        conn = PG.connect(target)
        conn.listen("c")
        listening.send(true)
        begin
          conn.wait_for_notify
        rescue Task::Cancelled => e
          # Cancelled between messages: the session is in step.
          leased.set(conn.closed? ? nil : conn.release)
          raise e
        end
        nil
      end
      listening.receive
      Task.sleep(20.ms)
      waiter.cancel
    end
    lease = leased.get || flunk("the cancelled connection was closed")
    conn = PG::Connection.adopt(lease)
    begin
      assert_true(conn.listening?)
      assert_equal(3, conn.exec("SELECT 3").rows[0].int(0))
      PG.connect(url).then { |n| n.notify("c", "still"); n.close }
      assert_equal("still", conn.wait_for_notify(timeout: 5.seconds)&.payload)
    ensure
      conn.close
    end
  end

  def test_unlisten_stops_delivery
    pair do |listener, notifier|
      listener.listen("a")
      listener.listen("b")
      listener.unlisten("a")
      assert_true(listener.listening?)
      notifier.notify("a", "dropped")
      notifier.notify("b", "kept")
      n = listener.wait_for_notify(timeout: 5.seconds)
      assert_equal(PG::Notification.new("b", "kept", notifier.process_id), n)
      listener.unlisten_all
      assert_false(listener.listening?)
      notifier.notify("b", "dropped")
      assert_nil(listener.wait_for_notify(timeout: 100.ms))
      assert_equal(0, listener.exec("SELECT count(*) FROM pg_listening_channels()").rows[0].int(0))
    end
  end

  def test_an_unlisten_in_a_transaction_leaves_listening_unsure
    pair do |listener, _|
      listener.listen("u")
      listener.transaction do |tx|
        tx.unlisten("u")
        raise ArgumentError.new("roll back")
      end
    rescue ArgumentError
      # The rollback undid the UNLISTEN.
      assert_equal(1, listener.exec("SELECT count(*) FROM pg_listening_channels()").rows[0].int(0))
      assert_true(listener.listening?)
      listener.unlisten_all
      assert_false(listener.listening?)
    end
  end

  def test_a_lease_keeps_an_unsure_listening
    pair do |listener, _|
      listener.listen("a")
      listener.listen("b")
      begin
        listener.transaction do |tx|
          tx.unlisten("b")
          raise ArgumentError.new("roll back")
        end
      rescue ArgumentError
      end
      conn = PG::Connection.adopt(listener.release || flunk("not released"))
      begin
        conn.unlisten("a")
        # "b" is still listened to: the rollback undid its UNLISTEN.
        assert_true(conn.listening?)
      ensure
        conn.close
      end
    end
  end

  def test_a_lease_keeps_the_queue_and_the_channels
    pair do |listener, notifier|
      listener.listen("l")
      notifier.notify("l", "queued")
      listener.exec("SELECT pg_sleep(0.05)")
      listener.exec("SELECT 1")
      lease = listener.release || flunk("not released")
      conn = PG::Connection.adopt(lease)
      begin
        assert_true(conn.listening?)
        assert_equal(["queued"], conn.notifications.map(&:payload))
        notifier.notify("l", "next")
        assert_equal("next", conn.wait_for_notify(timeout: 5.seconds)&.payload)
      ensure
        conn.close
      end
    end
  end

  def test_the_pool_unlistens_a_connection_given_back
    PG::Pool.open(url, size: 1) do |pool|
      pool.with do |c|
        c.listen("pooled")
        c.notify("pooled", "own")
        c.exec("SELECT pg_sleep(0.05)")
        c.exec("SELECT 1")
        nil
      end
      pool.with do |c|
        assert_false(c.listening?)
        assert_equal([], c.notifications)
        assert_equal(0, c.exec("SELECT count(*) FROM pg_listening_channels()").rows[0].int(0))
        nil
      end
      # A transaction left open is rolled back first, not committed with
      # the UNLISTEN undone.
      pool.with do |c|
        c.listen("pooled")
        c.exec("BEGIN")
        nil
      end
      pool.with do |c|
        assert_equal(0, c.exec("SELECT count(*) FROM pg_listening_channels()").rows[0].int(0))
        nil
      end
      nil
    end
  end

  def test_a_notify_in_a_transaction_arrives_at_commit
    pair do |listener, notifier|
      listener.listen("tx")
      notifier.transaction do |tx|
        tx.notify("tx", "committed")
        assert_nil(listener.wait_for_notify(timeout: 100.ms))
      end
      assert_equal("committed", listener.wait_for_notify(timeout: 5.seconds)&.payload)
      begin
        notifier.transaction do |tx|
          tx.notify("tx", "rolled back")
          raise ArgumentError.new("no")
        end
      rescue ArgumentError
      end
      assert_nil(listener.wait_for_notify(timeout: 100.ms))
    end
  end

  def test_names_and_payloads
    pair do |listener, notifier|
      # Quoted as an identifier: case, spaces and quotes kept.
      name = "Mixed \"Case\" name"
      listener.listen(name)
      listener.listen(name)
      notifier.notify(name, "日本語 ✓")
      n = listener.wait_for_notify(timeout: 5.seconds)
      assert_equal(PG::Notification.new(name, "日本語 ✓", notifier.process_id), n)
      # Listening twice delivers once.
      assert_nil(listener.wait_for_notify(timeout: 100.ms))
    end
  end

  def test_errors
    pair do |listener, notifier|
      assert_raise(ArgumentError) { listener.listen("") }
      assert_raise(ArgumentError) { listener.listen("a\x00b") }
      assert_raise(ArgumentError) { notifier.notify("", "x") }
      assert_raise(ArgumentError) { listener.listen("a" * 64) }
      assert_raise(ArgumentError) { notifier.notify("é" * 32, "x") }
      listener.listen("a" * 63)
      notifier.notify("a" * 63, "longest")
      assert_equal("a" * 63, listener.wait_for_notify(timeout: 5.seconds)&.channel)
      e = assert_raise(PG::ServerError) { notifier.notify("big", "x" * 8000) }.as(PG::ServerError)
      assert_equal("22023", e.code)
      assert_false(notifier.closed?)
      notifier.close
      assert_raise(PG::ConnectionError) { notifier.notify("x", "y") }
      listener.close
      assert_raise(PG::ConnectionError) { listener.wait_for_notify(timeout: 10.ms) }
    end
  end

  def test_the_server_ending_the_session_during_a_wait
    pair do |listener, notifier|
      listener.listen("end")
      notifier.query("SELECT pg_terminate_backend($1)", [listener.process_id])
      e = assert_raise(PG::ServerError) { listener.wait_for_notify(timeout: 5.seconds) }.as(PG::ServerError)
      assert_equal("57P01", e.code)
      assert_true(listener.closed?)
    end
  end
end
