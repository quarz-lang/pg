require "test"

# Against a real server (PG::Testing): queries, results, errors,
# transactions, and the authentication methods that need roles of their
# own.
class QueryTest < Test::Case
  SERVER = Atom[PG::Testing::Server | String].new("not started")

  def self.startup
    SERVER.set(PG::Testing.start_or_reason(hba: ["host all md5_user 127.0.0.1/32 md5", "host all clear_user 127.0.0.1/32 password"]))
  end

  def self.shutdown
    case SERVER.get
    in PG::Testing::Server => s then s.stop
    else nil
    end
  end

  def server -> PG::Testing::Server
    case SERVER.get
    in PG::Testing::Server => s then s
    in String => why then omit(why)
    end
  end

  def conn -> PG::Connection
    c = PG.connect(server.url)
    @opened = @opened.push(c)
    c
  end

  var @opened: Array[PG::Connection] = []

  def teardown
    @opened.each(&:close)
  end

  def test_exec
    r = conn.exec("SELECT 1 AS one, 'a' AS letter, NULL AS nothing")
    assert_equal(["one", "letter", "nothing"], r.column_names)
    assert_equal(1, r.size)
    row = r.rows[0]
    assert_equal("1", row[0])
    assert_equal("a", row["letter"])
    assert_nil(row["nothing"])
    assert_equal(1, row.int("one"))
    assert_equal("SELECT 1", r.command_tag)
    assert_equal(1, r.affected)
  end

  def test_several_statements
    c = conn
    results = c.exec_all("CREATE TEMP TABLE t (i int); INSERT INTO t VALUES (1), (2); SELECT i FROM t ORDER BY i")
    assert_equal(["CREATE TABLE", "INSERT 0 2", "SELECT 2"], results.map(&:command_tag))
    assert_nil(results[0].affected)
    assert_equal(2, results[1].affected)
    assert_equal([1, 2], c.exec("SELECT i FROM t ORDER BY i; SELECT i FROM t ORDER BY i").rows.map { |r| r.int(0) })
    assert_equal("", c.exec("").command_tag)
  end

  def test_query_parameters
    c = conn
    r = c.query("SELECT $1::int8 + 1, $2::text, $3::bool, $4::float8, $5::bytea, $6::text IS NULL, $7::text",
                [41, "é'\"; --", true, 2.5, b"\x00\xff", nil, :sym])
    row = r.rows[0]
    assert_equal(42, row.int(0))
    assert_equal("é'\"; --", row.string(1))
    assert_true(row.bool(2))
    assert_equal(2.5, row.float(3))
    assert_equal(b"\x00\xff", row.bytes(4))
    assert_true(row.bool(5))
    assert_equal("sym", row.string(6))
    assert_raise(ArgumentError) { c.query("SELECT $1", [1.seconds]) }
  end

  def test_types_round_trip
    c = conn
    t = Time.utc(2024, 3, 5, 14, 7, 9)
    r = c.query("SELECT $1::timestamptz, $2::timestamp, $3::date, 'NaN'::float8, '-Infinity'::float8, 1.5::numeric, " +
                "'{\"a\":1}'::jsonb, '00000000-0000-0000-0000-000000000001'::uuid, 9223372036854775807::int8",
                [t, "2024-03-05 14:07:09", "2024-03-05"])
    row = r.rows[0]
    assert_equal(t, row.time(0))
    assert_equal(t, row.time(1))
    assert_equal(Time.utc(2024, 3, 5), row.time(2))
    assert_true(row.float(3).nan?)
    assert_equal(-Float::INFINITY, row.float(4))
    assert_equal(1.5, row.float(5))
    assert_equal("{\"a\": 1}", row.string(6))
    assert_equal("00000000-0000-0000-0000-000000000001", row.string(7))
    assert_equal(9223372036854775807, row.int(8))
    assert_equal(PG::Types::TIMESTAMPTZ, r.columns[0].type)
  end

  def test_nulls
    row = conn.query("SELECT NULL::int, NULL::bool, NULL::bytea").rows[0]
    assert_nil(row.int?(0))
    assert_nil(row.bool?(1))
    assert_nil(row.bytes?(2))
    assert_raise(PG::NullError) { row.int(0) }
    assert_raise(PG::NullError) { row.bool(1) }
    assert_raise(IndexError) { row[3] }
    assert_raise(IndexError) { row["nope"] }
  end

  def test_errors_leave_the_connection_usable
    c = conn
    e = assert_raise(PG::ServerError) { c.exec("SELECT * FROM no_such_table") }.as(PG::ServerError)
    assert_equal("42P01", e.code)
    assert_equal(15, e.position)
    assert_equal(1, c.exec("SELECT 1").rows[0].int(0))
    e = assert_raise(PG::ServerError) { c.query("SELECT 1/$1::int", [0]) }.as(PG::ServerError)
    assert_equal("22012", e.code)
    assert_equal(1, c.query("SELECT $1::int", [1]).rows[0].int(0))
    c.exec("CREATE TEMP TABLE u (k int PRIMARY KEY)")
    c.query("INSERT INTO u VALUES ($1)", [1])
    e = assert_raise(PG::ServerError) { c.query("INSERT INTO u VALUES ($1)", [1]) }.as(PG::ServerError)
    assert_equal("23505", e.code)
    assert_equal("u_pkey", e.constraint)
    assert_match(/already exists/, e.detail || "")
    # A statement the server cancels on its own: a timeout.
    c.exec("SET statement_timeout = 50")
    e = assert_raise(PG::ServerError) { c.exec("SELECT pg_sleep(5)") }.as(PG::ServerError)
    assert_equal("57014", e.code)
    assert_equal(:idle, c.transaction_status)
  end

  def test_transaction_commits_and_rolls_back
    c = conn
    c.exec("CREATE TEMP TABLE acc (n int)")
    assert_equal(7, c.transaction { |tx| tx.query("INSERT INTO acc VALUES ($1)", [1]); 7 })
    assert_raise(RuntimeError) do
      c.transaction do |tx|
        tx.query("INSERT INTO acc VALUES ($1)", [2])
        raise "no"
      end
    end
    assert_equal(:idle, c.transaction_status)
    e = assert_raise(PG::ServerError) do
      c.transaction do |tx|
        tx.query("INSERT INTO acc VALUES ($1)", [3])
        begin
          tx.exec("SELECT * FROM no_such_table")
        rescue PG::ServerError
        end
        nil
      end
    end.as(PG::ServerError)
    assert_equal("25P02", e.code)
    assert_equal([1], c.exec("SELECT n FROM acc").rows.map { |r| r.int(0) })
  end

  def test_notices
    c = conn
    seen: Atom[Array[String]] = Atom[Array[String]].new([])
    c.on_notice { |fields| seen.update { |a| a.push(fields["M"]? || "") } }
    c.exec("DO $$ BEGIN RAISE NOTICE 'hello %', 42; END $$")
    assert_equal(["hello 42"], seen.get)
  end

  def test_cut_short_closes
    c = conn
    c.on_notice { |_| raise "from the handler" }
    assert_raise_message(/from the handler/) { c.exec("DO $$ BEGIN RAISE NOTICE 'x'; END $$; SELECT 1") }
    # The answer was read to its end: the connection is in step.
    assert_equal(2, c.exec("SELECT 2").rows[0].int(0))
    d = conn
    assert_raise(Task::Timeout) { Task.timeout(100.ms) { d.exec("SELECT pg_sleep(2)") } }
    assert_true(d.closed?)
    assert_raise(PG::ConnectionError) { d.exec("SELECT 1") }
  end

  def test_notifications_are_dropped
    c = conn
    c.exec("LISTEN chan")
    c.exec("NOTIFY chan, 'hi'")
    assert_equal(3, c.exec("SELECT 3").rows[0].int(0))
  end

  def test_transaction_left_with_return_rolls_back
    c = conn
    c.exec("CREATE TEMP TABLE r (n int)")
    assert_equal(5, insert_and_return(c))
    assert_equal(:idle, c.transaction_status)
    assert_equal(0, c.exec("SELECT count(*) FROM r").rows[0].int(0))
  end

  def insert_and_return(c: PG::Connection) -> Int
    c.transaction do |tx|
      tx.query("INSERT INTO r VALUES ($1)", [1])
      return 5
    end
    0
  end

  def test_nested_transaction_refused
    c = conn
    c.transaction do |tx|
      assert_raise(PG::TransactionError) { tx.transaction { |_| nil } }
      nil
    end
    c.exec("BEGIN")
    assert_raise(PG::TransactionError) { c.transaction { |_| nil } }
    c.exec("ROLLBACK")
  end

  def test_time_offset_kept_in_timestamp
    t = Time.parse("2024-03-05T23:07:09+09:00")
    row = conn.query("SELECT $1::timestamp, $2::timestamptz", [t, t]).rows[0]
    assert_equal(t, row.time(0))
    assert_equal(t, row.time(1))
  end

  # A role hashed with 20,000 SCRAM iterations (PostgreSQL 16+): the
  # client hashes on a helper thread, and a lower cap refuses it.
  def test_scram_iterations_above_the_default
    admin = conn
    omit_if(admin.server_version.to_i < 16, "scram_iterations needs PostgreSQL 16")
    admin.exec("DROP ROLE IF EXISTS iter_user")
    admin.exec("SET scram_iterations = 20000")
    admin.exec("CREATE ROLE iter_user LOGIN PASSWORD 'iter-secret'")
    config = PG.parse_url(server.url)
    c = PG.connect(host: config.host, port: config.port, user: "iter_user", password: "iter-secret", database: "postgres")
    assert_equal("iter_user", c.exec("SELECT current_user").rows[0].string(0))
    c.close
    assert_raise_message(/20000 iterations, more than the 10000 allowed/) do
      PG.connect(host: config.host, port: config.port, user: "iter_user", password: "iter-secret",
                 database: "postgres", max_scram_iterations: 10_000)
    end
    admin.exec("DROP ROLE iter_user")
  end

  def prepared_on_server(c: PG::Connection) -> Int
    c.exec("SELECT count(*) FROM pg_prepared_statements").rows[0].int(0)
  end

  def test_statements_prepared_once_and_reused
    c = conn
    3.times { |i| assert_equal(i, c.query("SELECT $1::int", [i]).rows[0].int(0)) }
    assert_equal(1, c.prepared_statements)
    assert_equal(1, prepared_on_server(c))
  end

  def test_statement_cache_evicts
    config = PG.parse_url(server.url)
    c = PG.connect(host: config.host, port: config.port, user: config.user, password: config.password,
                   database: "postgres", statement_cache_size: 2)
    @opened = @opened.push(c)
    ["SELECT 1", "SELECT 2", "SELECT 3", "SELECT 4"].each { |q| c.query(q) }
    assert_equal(2, c.prepared_statements)
    assert_equal(2, prepared_on_server(c))
    c.query("SELECT 3")
    c.query("SELECT 5")
    assert_equal(2, prepared_on_server(c))
  end

  def test_statement_cache_off
    c = PG.connect(server.url + (server.url.include?("?") ? "&" : "?") + "statement_cache_size=0")
    @opened = @opened.push(c)
    c.query("SELECT $1::int", [1])
    assert_equal(0, c.prepared_statements)
    assert_equal(0, prepared_on_server(c))
  end

  def test_changed_result_type_reprepares
    c = conn
    c.exec("CREATE TEMP TABLE w (a int)")
    c.query("INSERT INTO w VALUES ($1)", [1])
    assert_equal(1, c.query("SELECT * FROM w").rows[0].int(0))
    c.exec("ALTER TABLE w ADD COLUMN b text")
    # Outside a transaction: prepared again and retried.
    assert_equal(["a", "b"], c.query("SELECT * FROM w").column_names)
    c.exec("ALTER TABLE w ADD COLUMN c text")
    e = assert_raise(PG::ServerError) do
      c.transaction { |tx| tx.query("SELECT * FROM w") }
    end.as(PG::ServerError)
    assert_equal("0A000", e.code)
    assert_equal(["a", "b", "c"], c.query("SELECT * FROM w").column_names)
  end

  def test_cache_stays_true_to_the_server
    c = conn
    # A notice handler's exception after the statement was prepared.
    c.on_notice { |_| raise "handler" }
    3.times { assert_raise(RuntimeError) { c.query("DO $$ BEGIN RAISE NOTICE 'hi'; END $$") } }
    assert_equal(1, c.prepared_statements)
    d = PG.connect(server.url + (server.url.include?("?") ? "&" : "?") + "statement_cache_size=1")
    @opened = @opened.push(d)
    d.query("SELECT 10")
    assert_raise(ArgumentError) { d.query("SELECT 11\0") }
    d.query("SELECT 12")
    assert_equal(1, prepared_on_server(d))
    # DISCARD ALL through query, and a statement gone from the server.
    c.on_notice { |_| nil }
    c.query("SELECT $1::int", [1])
    c.query("DISCARD ALL")
    assert_equal(0, c.prepared_statements)
  end

  def test_statement_gone_is_reprepared
    c = conn
    c.query("SELECT $1::int", [1])
    # The first statement of a connection is qz1; dropping it behind the
    # cache's back makes the next call fail with 26000, then retry.
    c.exec("DEALLOCATE qz1")
    assert_equal(1, c.prepared_statements)
    assert_equal(2, c.query("SELECT $1::int", [2]).rows[0].int(0))
    assert_equal(1, prepared_on_server(c))
  end

  def test_discard_all_clears_the_cache
    c = conn
    c.query("SELECT $1::int", [1])
    c.exec("DISCARD ALL")
    assert_equal(0, c.prepared_statements)
    assert_equal(2, c.query("SELECT $1::int", [2]).rows[0].int(0))
  end

  def test_failed_parse_is_not_cached
    c = conn
    assert_raise(PG::ServerError) { c.query("SELEC 1") }
    assert_equal(0, c.prepared_statements)
    assert_raise(PG::ServerError) { c.query("SELECT 1/$1::int", [0]) }
    assert_equal(1, c.prepared_statements)
    assert_equal(1, c.query("SELECT 1/$1::int", [1]).rows[0].int(0))
  end

  def test_md5_and_cleartext_roles
    omit_unless(server.ours?, "PG_TEST_URL's server: its pg_hba.conf is not ours")
    admin = conn
    admin.exec("SET password_encryption = 'md5'")
    admin.exec("CREATE ROLE md5_user LOGIN PASSWORD 'md5-secret'")
    admin.exec("RESET password_encryption")
    admin.exec("CREATE ROLE clear_user LOGIN PASSWORD 'clear-secret'")
    c = PG.connect(host: "127.0.0.1", port: server.port, user: "md5_user", password: "md5-secret", database: "postgres")
    assert_equal("md5_user", c.exec("SELECT current_user").rows[0].string(0))
    c.close
    assert_raise_message(/in clear over TCP/) do
      PG.connect(host: "127.0.0.1", port: server.port, user: "clear_user", password: "clear-secret", database: "postgres")
    end
    c = PG.connect(host: "127.0.0.1", port: server.port, user: "clear_user", password: "clear-secret",
                   database: "postgres", allow_cleartext: true)
    assert_equal("clear_user", c.exec("SELECT current_user").rows[0].string(0))
    c.close
  end

  # An array is one parameter, whatever its length: one prepared
  # statement serves them all, with no limit of 65535 parameters.
  def test_array_parameters
    c = conn
    c.exec("CREATE TEMP TABLE many (id bigint PRIMARY KEY, name text)")
    c.exec("INSERT INTO many SELECT i, 'n' || i FROM generate_series(1, 70000) AS i")
    sql = "SELECT count(*) FROM many WHERE id = ANY($1)"
    assert_equal(0, c.query(sql, [Array[Int].new]).rows[0].int(0))
    assert_equal(1, c.query(sql, [[5]]).rows[0].int(0))
    assert_equal(3, c.query(sql, [[1, 2, 3]]).rows[0].int(0))
    ids = (1..70000).to_a
    assert_equal(70000, c.query(sql, [ids]).rows[0].int(0))
    # A nil element is NULL, which `= ANY` never finds.
    assert_equal(2, c.query(sql, [[1, nil, 2]]).rows[0].int(0))
    # (One for the typed arrays, one for the empty one, which has no type
    # to give and is inferred from `id`.)
    assert_equal(2, c.query("SELECT count(*) FROM pg_prepared_statements WHERE statement = $1", [sql]).rows[0].int(0))
    # Typed, `unnest($1)` needs no cast; an empty array has no type to
    # give (OID 0): it needs one.
    un: Array[Int?] = [3, nil, 1]
    assert_equal(un, c.query("SELECT unnest($1) AS x", [[3, nil, 1]]).rows.map { |r| r.int?(0) })
    assert_equal(0, c.query("SELECT count(*) FROM unnest($1::bigint[])", [Array[Int].new]).rows[0].int(0))
    assert_raise(PG::ServerError) { c.query("SELECT unnest($1)", [Array[Int].new]) }
    assert_equal(["n1", "n70000"], c.query("SELECT name FROM many WHERE name = ANY($1) ORDER BY id", [["n1", "n70000", "x"]]).rows.map { |r| r.string(0) })
    # Untyped (Float, String, Time), a bare `unnest($1)` needs a cast.
    assert_raise(PG::ServerError) { c.query("SELECT unnest($1)", [["a"]]) }
    assert_equal(["a"], c.query("SELECT unnest($1::text[])", [["a"]]).rows.map { |r| r.string(0) })
  end

  # Arrays of Floats, Strings and Times are untyped, as their scalars
  # are: the column decides.
  def test_untyped_arrays_meet_the_column
    c = conn
    c.exec("CREATE TEMP TABLE kinds (u uuid, d date, n numeric, r real, ts timestamp)")
    c.exec("INSERT INTO kinds VALUES ('00000000-0000-0000-0000-000000000001', '2024-03-05', 0.30000000000000004, 0.1, '2024-03-05 14:07:09')")
    count = ->(sql: String, p: Object?) { c.query("SELECT count(*) FROM kinds WHERE #{sql}", [p]).rows[0].int(0) }
    assert_equal(1, count.call("u = ANY($1)", ["00000000-0000-0000-0000-000000000001"]))
    assert_equal(1, count.call("d = ANY($1)", ["2024-03-05"]))
    assert_equal(1, count.call("n = ANY($1)", [0.30000000000000004]))
    assert_equal(1, count.call("r = ANY($1)", [0.1]))
    # A `timestamp` column keeps the instant sent in UTC, whatever the
    # session's time zone, as a scalar Time does.
    c.exec("SET TimeZone = 'Asia/Tokyo'")
    t = Time.utc(2024, 3, 5, 14, 7, 9)
    assert_equal(1, count.call("ts = ANY($1)", [t]))
    assert_equal(1, count.call("ts = $1", t))
    c.query("INSERT INTO kinds (ts) SELECT unnest($1::timestamp[])", [[t]])
    assert_equal(2, count.call("ts = ANY($1)", [t]))
  end

  # (One SQL text, `SELECT $1 AS a`, with arrays of each typed kind: a
  # statement for each.)
  def test_array_round_trips
    c = conn
    texts: Array[String?] = ["b,c", "d\"e", "f\\g", "", "NULL", nil, "h i", "{j}", "日本"]
    assert_equal(texts, c.query("SELECT $1::text[] AS a", [texts]).rows[0].strings("a"))
    ints: Array[Int?] = [1, nil, -9223372036854775808]
    assert_equal(ints, c.query("SELECT $1 AS a", [ints]).rows[0].ints("a"))
    floats: Array[Float?] = [1.5, nil, -0.25]
    assert_equal(floats, c.query("SELECT $1::float8[] AS a", [floats]).rows[0].floats("a"))
    bools: Array[Bool?] = [true, nil, false]
    assert_equal(bools, c.query("SELECT $1 AS a", [bools]).rows[0].bools("a"))
    t1 = Time.utc(2024, 3, 5, 14, 7, 9)
    t2 = Time.utc(1999, 12, 31, 23, 59, 59)
    times: Array[Time?] = [t1, nil, t2]
    got = c.query("SELECT $1::timestamptz[] AS a", [times]).rows[0].times("a")
    secs: Array[Int?] = [t1.to_i, nil, t2.to_i]
    assert_equal(secs, got.map { |t| t ? t.to_i : nil })
    assert_equal(["boolean[]"], c.query("SELECT pg_typeof($1)::text", [[true]]).rows.map { |r| r.string(0) })
    # Bytes are sent as bytea[]; read back as text.
    hex: Array[String?] = ["\\x01ff"]
    assert_equal(hex, c.query("SELECT $1 AS a", [[b"\x01\xff"]]).rows[0].strings("a"))
    # A NULL array, and an empty one.
    row = c.exec("SELECT NULL::int8[] AS n, '{}'::int8[] AS e, ARRAY[[1,2],[3,4]] AS m").rows[0]
    assert_nil(row.ints?("n"))
    assert_raise(PG::NullError) { row.ints("n") }
    assert_equal(Array[Int?].new, row.ints("e"))
    assert_raise(ArgumentError) { row.ints("m") }
    assert_equal("{{1,2},{3,4}}", row["m"])
  end
end
