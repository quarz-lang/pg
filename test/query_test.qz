require "test"
require_relative "server"

# Against a real server (test/server.qz): queries, results, errors,
# transactions, and the authentication methods that need roles of their
# own.
class QueryTest < Test::Case
  SERVER = Atom[TestServer | String].new("not started")

  def self.startup
    SERVER.set(TestServer.start)
  end

  def self.shutdown
    case SERVER.get
    in TestServer => s then s.stop
    else nil
    end
  end

  def server -> TestServer
    case SERVER.get
    in TestServer => s then s
    in String => why then omit(why)
    end
  end

  def conn -> PG::Connection
    c = PG.connect(server.url)
    @opened = @opened.push(c)
    c
  end

  var @opened: Array[PG::Connection] = []

  def teardown
    @opened.each(&:close)
  end

  def test_exec
    r = conn.exec("SELECT 1 AS one, 'a' AS letter, NULL AS nothing")
    assert_equal(["one", "letter", "nothing"], r.column_names)
    assert_equal(1, r.size)
    row = r.rows[0]
    assert_equal("1", row[0])
    assert_equal("a", row["letter"])
    assert_nil(row["nothing"])
    assert_equal(1, row.int("one"))
    assert_equal("SELECT 1", r.command_tag)
    assert_equal(1, r.affected)
  end

  def test_several_statements
    c = conn
    results = c.exec_all("CREATE TEMP TABLE t (i int); INSERT INTO t VALUES (1), (2); SELECT i FROM t ORDER BY i")
    assert_equal(["CREATE TABLE", "INSERT 0 2", "SELECT 2"], results.map(&:command_tag))
    assert_nil(results[0].affected)
    assert_equal(2, results[1].affected)
    assert_equal([1, 2], c.exec("SELECT i FROM t ORDER BY i; SELECT i FROM t ORDER BY i").rows.map { |r| r.int(0) })
    assert_equal("", c.exec("").command_tag)
  end

  def test_query_parameters
    c = conn
    r = c.query("SELECT $1::int8 + 1, $2::text, $3::bool, $4::float8, $5::bytea, $6::text IS NULL, $7::text",
                [41, "é'\"; --", true, 2.5, b"\x00\xff", nil, :sym])
    row = r.rows[0]
    assert_equal(42, row.int(0))
    assert_equal("é'\"; --", row.string(1))
    assert_true(row.bool(2))
    assert_equal(2.5, row.float(3))
    assert_equal(b"\x00\xff", row.bytes(4))
    assert_true(row.bool(5))
    assert_equal("sym", row.string(6))
    assert_raise(ArgumentError) { c.query("SELECT $1", [[1]]) }
  end

  def test_types_round_trip
    c = conn
    t = Time.utc(2024, 3, 5, 14, 7, 9)
    r = c.query("SELECT $1::timestamptz, $2::timestamp, $3::date, 'NaN'::float8, '-Infinity'::float8, 1.5::numeric, " +
                "'{\"a\":1}'::jsonb, '00000000-0000-0000-0000-000000000001'::uuid, 9223372036854775807::int8",
                [t, "2024-03-05 14:07:09", "2024-03-05"])
    row = r.rows[0]
    assert_equal(t, row.time(0))
    assert_equal(t, row.time(1))
    assert_equal(Time.utc(2024, 3, 5), row.time(2))
    assert_true(row.float(3).nan?)
    assert_equal(-Float::INFINITY, row.float(4))
    assert_equal(1.5, row.float(5))
    assert_equal("{\"a\": 1}", row.string(6))
    assert_equal("00000000-0000-0000-0000-000000000001", row.string(7))
    assert_equal(9223372036854775807, row.int(8))
    assert_equal(PG::Types::TIMESTAMPTZ, r.columns[0].type)
  end

  def test_nulls
    row = conn.query("SELECT NULL::int, NULL::bool, NULL::bytea").rows[0]
    assert_nil(row.int?(0))
    assert_nil(row.bool?(1))
    assert_nil(row.bytes?(2))
    assert_raise(PG::NullError) { row.int(0) }
    assert_raise(PG::NullError) { row.bool(1) }
    assert_raise(IndexError) { row[3] }
    assert_raise(IndexError) { row["nope"] }
  end

  def test_errors_leave_the_connection_usable
    c = conn
    e = assert_raise(PG::ServerError) { c.exec("SELECT * FROM no_such_table") }.as(PG::ServerError)
    assert_equal("42P01", e.code)
    assert_equal(15, e.position)
    assert_equal(1, c.exec("SELECT 1").rows[0].int(0))
    e = assert_raise(PG::ServerError) { c.query("SELECT 1/$1::int", [0]) }.as(PG::ServerError)
    assert_equal("22012", e.code)
    assert_equal(1, c.query("SELECT $1::int", [1]).rows[0].int(0))
    c.exec("CREATE TEMP TABLE u (k int PRIMARY KEY)")
    c.query("INSERT INTO u VALUES ($1)", [1])
    e = assert_raise(PG::ServerError) { c.query("INSERT INTO u VALUES ($1)", [1]) }.as(PG::ServerError)
    assert_equal("23505", e.code)
    assert_equal("u_pkey", e.constraint)
    assert_match(/already exists/, e.detail || "")
    # A statement the server cancels on its own: a timeout.
    c.exec("SET statement_timeout = 50")
    e = assert_raise(PG::ServerError) { c.exec("SELECT pg_sleep(5)") }.as(PG::ServerError)
    assert_equal("57014", e.code)
    assert_equal(:idle, c.transaction_status)
  end

  def test_transaction_commits_and_rolls_back
    c = conn
    c.exec("CREATE TEMP TABLE acc (n int)")
    assert_equal(7, c.transaction { |tx| tx.query("INSERT INTO acc VALUES ($1)", [1]); 7 })
    assert_raise(RuntimeError) do
      c.transaction do |tx|
        tx.query("INSERT INTO acc VALUES ($1)", [2])
        raise "no"
      end
    end
    assert_equal(:idle, c.transaction_status)
    e = assert_raise(PG::ServerError) do
      c.transaction do |tx|
        tx.query("INSERT INTO acc VALUES ($1)", [3])
        begin
          tx.exec("SELECT * FROM no_such_table")
        rescue PG::ServerError
        end
        nil
      end
    end.as(PG::ServerError)
    assert_equal("25P02", e.code)
    assert_equal([1], c.exec("SELECT n FROM acc").rows.map { |r| r.int(0) })
  end

  def test_notices
    c = conn
    seen: Atom[Array[String]] = Atom[Array[String]].new([])
    c.on_notice { |fields| seen.update { |a| a.push(fields["M"]? || "") } }
    c.exec("DO $$ BEGIN RAISE NOTICE 'hello %', 42; END $$")
    assert_equal(["hello 42"], seen.get)
  end

  def test_cut_short_closes
    c = conn
    c.on_notice { |_| raise "from the handler" }
    assert_raise_message(/from the handler/) { c.exec("DO $$ BEGIN RAISE NOTICE 'x'; END $$; SELECT 1") }
    # The answer was read to its end: the connection is in step.
    assert_equal(2, c.exec("SELECT 2").rows[0].int(0))
    d = conn
    assert_raise(Task::Timeout) { Task.timeout(100.ms) { d.exec("SELECT pg_sleep(2)") } }
    assert_true(d.closed?)
    assert_raise(PG::ConnectionError) { d.exec("SELECT 1") }
  end

  def test_notifications_are_dropped
    c = conn
    c.exec("LISTEN chan")
    c.exec("NOTIFY chan, 'hi'")
    assert_equal(3, c.exec("SELECT 3").rows[0].int(0))
  end

  def test_transaction_left_with_return_rolls_back
    c = conn
    c.exec("CREATE TEMP TABLE r (n int)")
    assert_equal(5, insert_and_return(c))
    assert_equal(:idle, c.transaction_status)
    assert_equal(0, c.exec("SELECT count(*) FROM r").rows[0].int(0))
  end

  def insert_and_return(c: PG::Connection) -> Int
    c.transaction do |tx|
      tx.query("INSERT INTO r VALUES ($1)", [1])
      return 5
    end
    0
  end

  def test_nested_transaction_refused
    c = conn
    c.transaction do |tx|
      assert_raise(PG::TransactionError) { tx.transaction { |_| nil } }
      nil
    end
    c.exec("BEGIN")
    assert_raise(PG::TransactionError) { c.transaction { |_| nil } }
    c.exec("ROLLBACK")
  end

  def test_time_offset_kept_in_timestamp
    t = Time.parse("2024-03-05T23:07:09+09:00")
    row = conn.query("SELECT $1::timestamp, $2::timestamptz", [t, t]).rows[0]
    assert_equal(t, row.time(0))
    assert_equal(t, row.time(1))
  end

  # A role hashed with 20,000 SCRAM iterations (PostgreSQL 16+): the
  # client hashes on a helper thread, and a lower cap refuses it.
  def test_scram_iterations_above_the_default
    admin = conn
    omit_if(admin.server_version.to_i < 16, "scram_iterations needs PostgreSQL 16")
    admin.exec("DROP ROLE IF EXISTS iter_user")
    admin.exec("SET scram_iterations = 20000")
    admin.exec("CREATE ROLE iter_user LOGIN PASSWORD 'iter-secret'")
    config = PG.parse_url(server.url)
    c = PG.connect(host: config.host, port: config.port, user: "iter_user", password: "iter-secret", database: "postgres")
    assert_equal("iter_user", c.exec("SELECT current_user").rows[0].string(0))
    c.close
    assert_raise_message(/20000 iterations, more than the 10000 allowed/) do
      PG.connect(host: config.host, port: config.port, user: "iter_user", password: "iter-secret",
                 database: "postgres", max_scram_iterations: 10_000)
    end
    admin.exec("DROP ROLE iter_user")
  end

  def test_md5_and_cleartext_roles
    omit_unless(server.ours?, "PG_TEST_URL's server: its pg_hba.conf is not ours")
    admin = conn
    admin.exec("SET password_encryption = 'md5'")
    admin.exec("CREATE ROLE md5_user LOGIN PASSWORD 'md5-secret'")
    admin.exec("RESET password_encryption")
    admin.exec("CREATE ROLE clear_user LOGIN PASSWORD 'clear-secret'")
    c = PG.connect(host: "127.0.0.1", port: server.port, user: "md5_user", password: "md5-secret", database: "postgres")
    assert_equal("md5_user", c.exec("SELECT current_user").rows[0].string(0))
    c.close
    assert_raise_message(/in clear over TCP/) do
      PG.connect(host: "127.0.0.1", port: server.port, user: "clear_user", password: "clear-secret", database: "postgres")
    end
    c = PG.connect(host: "127.0.0.1", port: server.port, user: "clear_user", password: "clear-secret",
                   database: "postgres", allow_cleartext: true)
    assert_equal("clear_user", c.exec("SELECT current_user").rows[0].string(0))
    c.close
  end
end
