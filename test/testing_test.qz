require "test"

# `PG::Testing` itself: a server for a block, stopped afterwards.
class TestingTest < Test::Case
  def test_with_cluster
    url = begin
      PG::Testing.with_cluster do |u|
        c = PG.connect(u)
        begin
          assert_equal("1", c.exec("SELECT 1").rows[0][0])
        ensure
          c.close
        end
        u
      end
    rescue PG::Testing::Unavailable => e
      omit(e.message)
    end
    env = ENV["PG_TEST_URL"]?
    unless env && !env.empty?
      # Ours, stopped: nothing listens any more.
      assert_raise(PG::ConnectionError) { PG.connect(url) }
    end
  end

  # A failed test prints the server: its password stays out.
  def test_inspect_leaves_the_password_out
    server = PG::Testing::Server.new("postgres://ann:s3cr3t-pw@127.0.0.1:5432/shop", nil, "/usr/bin")
    text = server.inspect
    refute(text.include?("s3cr3t-pw"))
    assert(text.include?("[FILTERED]"))
    assert(text.include?("127.0.0.1"))
    assert_equal(text, server.to_s)
    refute("#{server}".include?("s3cr3t-pw"))
  end

  # The URL as text, its password masked without reading it as a
  # configuration (PG.parse_url reads the environment, which a `to_s` run
  # at compile time cannot reach).
  def test_inspect_masks_the_url_as_text
    shown = ->(url: String) { PG::Testing::Server.new(url, "/tmp/d", "/usr/bin").inspect }
    assert_equal("#<PG::Testing::Server url: \"postgres://ann:[FILTERED]@127.0.0.1:5432/shop\", dir: \"/tmp/d\">",
                 shown.call("postgres://ann:s3cr3t@127.0.0.1:5432/shop"))
    assert_equal("#<PG::Testing::Server url: \"postgres://ann@127.0.0.1:5432/shop\", dir: \"/tmp/d\">",
                 shown.call("postgres://ann@127.0.0.1:5432/shop"))
    assert_equal("#<PG::Testing::Server url: \"postgres://127.0.0.1/shop?sslmode=disable\", dir: \"/tmp/d\">",
                 shown.call("postgres://127.0.0.1/shop?sslmode=disable"))
    # Escaped characters, a raw `@` and `:` in the password, a password
    # parameter, and a quote and a backslash, which inspect escapes.
    assert_equal("#<PG::Testing::Server url: \"postgres://a%40b:[FILTERED]@h/d\", dir: \"/tmp/d\">",
                 shown.call("postgres://a%40b:p%2Fw%40rd@h/d"))
    assert_equal("#<PG::Testing::Server url: \"postgres://ann:[FILTERED]@h/d\", dir: \"/tmp/d\">",
                 shown.call("postgres://ann:p@ss:w@h/d"))
    assert_equal("#<PG::Testing::Server url: \"postgres://h/d?user=ann&password=[FILTERED]&sslmode=disable\", dir: \"/tmp/d\">",
                 shown.call("postgres://h/d?user=ann&password=s3cr3t&sslmode=disable"))
    assert_equal("#<PG::Testing::Server url: \"postgres://a\\\"b:[FILTERED]@h/d\", dir: \"/tmp/d\">",
                 shown.call("postgres://a\"b:x\\y@h/d"))
  end
end
