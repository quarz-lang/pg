require "test"

# `PG::Testing` itself: a server for a block, stopped afterwards.
class TestingTest < Test::Case
  def test_with_cluster
    url = begin
      PG::Testing.with_cluster do |u|
        c = PG.connect(u)
        begin
          assert_equal("1", c.exec("SELECT 1").rows[0][0])
        ensure
          c.close
        end
        u
      end
    rescue PG::Testing::Unavailable => e
      omit(e.message)
    end
    env = ENV["PG_TEST_URL"]?
    unless env && !env.empty?
      # Ours, stopped: nothing listens any more.
      assert_raise(PG::ConnectionError) { PG.connect(url) }
    end
  end

  # A failed test prints the server: its password stays out.
  def test_inspect_leaves_the_password_out
    server = PG::Testing::Server.new("postgres://ann:s3cr3t-pw@127.0.0.1:5432/shop", nil, "/usr/bin")
    text = server.inspect
    refute(text.include?("s3cr3t-pw"))
    assert(text.include?("[FILTERED]"))
    assert(text.include?("127.0.0.1"))
    assert_equal(text, server.to_s)
    refute("#{server}".include?("s3cr3t-pw"))
  end
end
