require "test"

# `PG::Testing` itself: a server for a block, stopped afterwards.
class TestingTest < Test::Case
  def test_with_cluster
    url = begin
      PG::Testing.with_cluster do |u|
        c = PG.connect(u)
        begin
          assert_equal("1", c.exec("SELECT 1").rows[0][0])
        ensure
          c.close
        end
        u
      end
    rescue PG::Testing::Unavailable => e
      omit(e.message)
    end
    env = ENV["PG_TEST_URL"]?
    unless env && !env.empty?
      # Ours, stopped: nothing listens any more.
      assert_raise(PG::ConnectionError) { PG.connect(url) }
    end
  end

  # A failed test prints the server: its password stays out.
  def test_inspect_leaves_the_password_out
    server = PG::Testing::Server.new("postgres://ann:s3cr3t-pw@127.0.0.1:5432/shop", nil, "/usr/bin")
    text = server.inspect
    refute(text.include?("s3cr3t-pw"))
    assert(text.include?("[FILTERED]"))
    assert(text.include?("127.0.0.1"))
    assert_equal(text, server.to_s)
    refute("#{server}".include?("s3cr3t-pw"))
  end

  # The URL as PG.parse_url reads it, its password masked, without
  # PG.parse_url itself (which reads the environment, which a `to_s` run
  # at compile time cannot reach).
  def test_inspect_masks_the_url_as_text
    shown = ->(url: String) { PG::Testing::Server.new(url, "/tmp/d", "/usr/bin").inspect }
    cases = [
      ["postgres://ann:s3cret@127.0.0.1:5432/shop", "\"postgres://ann:[FILTERED]@127.0.0.1:5432/shop\""],
      ["postgres://ann@127.0.0.1:5432/shop", "\"postgres://ann@127.0.0.1:5432/shop\""],
      ["postgresql://127.0.0.1/shop?sslmode=disable", "\"postgresql://127.0.0.1/shop?sslmode=disable\""],
      ["postgres://ann:@h/d", "\"postgres://ann:[FILTERED]@h/d\""],
      # Escapes in the user part, kept as written.
      ["postgres://a%40b:p%2Fw%40rd@h/d", "\"postgres://a%40b:[FILTERED]@h/d\""],
      ["postgres://[::1]:5432/d", "\"postgres://[::1]:5432/d\""],
      # Password parameters, by their decoded names, every one of them.
      ["postgres://h/d?user=ann&password=s3cret&sslmode=disable", "\"postgres://h/d?user=ann&password=[FILTERED]&sslmode=disable\""],
      ["postgres://h/d?pass%77ord=s3cret", "\"postgres://h/d?pass%77ord=[FILTERED]\""],
      ["postgres://h/d?application_name=x&passw%6Frd=s3cret", "\"postgres://h/d?application_name=x&passw%6Frd=[FILTERED]\""],
      ["postgres://h/d?password=a&password=b", "\"postgres://h/d?password=[FILTERED]&password=[FILTERED]\""],
      # A quote and a backslash, which inspect escapes.
      ["postgres://a\"b:x\\y@h/d", "\"postgres://a\\\"b:[FILTERED]@h/d\""],
      # URLs parse_url refuses: never shown, not even in part.
      ["postgres://ann:p/w@h/d", "[FILTERED]"],
      ["postgres://ann:p@ss:w@h/d", "[FILTERED]"],
      ["postgres://ann:pw@h/d?password=%zz", "[FILTERED]"],
      ["postgres://ann:p%zzw@h/d", "[FILTERED]"],
      ["mysql://ann:pw@h/d", "[FILTERED]"],
      # A name parse_url does not know (passWord) may be a password.
      ["postgres://h/d?pass%57ord=s3cret", "[FILTERED]"],
      ["postgres://h/d?s3cret", "[FILTERED]"],
      ["postgres://h/d?password=x&port=99999", "[FILTERED]"]
    ]
    cases.each do |c|
      assert_equal("#<PG::Testing::Server url: #{c[1]}, dir: \"/tmp/d\">", shown.call(c[0]), c[0])
    end
  end
end
